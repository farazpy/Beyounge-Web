<%- include('../partials/head') %>

<body>
  <%- include('../partials/header') %>

  <main style="padding-top: 100px; padding-bottom: 80px; background-color: var(--bg-surface);">
    
    <!-- Hero / Intro -->
    <section class="section" style="padding-top: 2rem; padding-bottom: 2rem;">
      <div class="container container-narrow">
        <div style="text-align: center; margin-bottom: 2rem;">
          <h1 style="margin-bottom: 0.5rem;">Community <span class="gradient-text">Feed</span></h1>
          <p>Discover real-time workouts, nutrition updates, and fitness reels from the Beyounge community.</p>
        </div>
      </div>
    </section>

    <!-- Reels Section -->
    <section class="section" style="padding-top: 0; padding-bottom: 2rem;">
      <div class="container container-narrow">
        <h3 style="font-size: 1.25rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="play-circle" style="color: var(--primary-emerald);"></i> Trending Reels
        </h3>
        
        <% if (reels && reels.length > 0) { %>
          <!-- Horizontal Scrollable Reels Container -->
          <div style="display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 1rem; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;" class="hide-scrollbar">
            <% reels.forEach(reel => { %>
              <div style="flex: 0 0 160px; height: 280px; position: relative; border-radius: var(--radius-md); overflow: hidden; scroll-snap-align: start; cursor: pointer;" class="reel-card">
                <% if (reel.video) { %>
                  <img src="<%= reel.video %>" alt="Reel by <%= reel.user %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" class="reel-thumbnail">
                <% } else { %>
                  <div class="reel-thumbnail" style="width: 100%; height: 100%; background: #0F172A; display: flex; align-items: center; justify-content: center;">
                    <i data-lucide="film" style="color: var(--primary-emerald); width: 32px; height: 32px;"></i>
                  </div>
                <% } %>
                <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.3); pointer-events: none;"></div>
                
                <div style="position: absolute; bottom: 10px; left: 10px; right: 10px; color: white;">
                  <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem;">
                    <% if (reel.avatar) { %>
                      <img src="<%= reel.avatar %>" alt="<%= reel.user %>" style="width: 20px; height: 20px; border-radius: 50%; border: 1px solid white; object-fit: cover;">
                    <% } else { %>
                      <div style="width: 20px; height: 20px; border-radius: 50%; border: 1px solid white; background: var(--primary-emerald); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700;">
                        <%= (reel.displayName || reel.user || 'U').replace('@', '').charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                    <span style="font-size: 0.75rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= reel.user %></span>
                  </div>
                  <div style="font-size: 0.7rem; color: rgba(255,255,255,0.8); display: flex; align-items: center; gap: 0.2rem;">
                    <i data-lucide="heart" style="width: 12px; height: 12px;"></i> <%= reel.likes %> • <i data-lucide="message-circle" style="width: 12px; height: 12px;"></i> <%= reel.comments %>
                  </div>
                </div>

                <!-- Play Button Overlay -->
                <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s;" class="reel-play-overlay">
                   <div style="width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center;">
                      <i data-lucide="play" style="color: white; width: 20px; height: 20px; margin-left: 2px;"></i>
                   </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="glass-card" style="padding: 2rem; text-align: center; border-radius: var(--radius-lg); color: var(--text-muted);">
            <i data-lucide="film" style="width: 28px; height: 28px; color: var(--text-muted); margin-bottom: 0.5rem;"></i>
            <p style="margin: 0; font-size: 0.95rem;">No reels found.</p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Feed Posts Section -->
    <section class="section" style="padding-top: 1rem;">
      <div class="container container-narrow">
        <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="message-square" style="color: var(--primary-emerald);"></i> Latest Posts
        </h3>

        <!-- Twitter-Style Filter & Stream View -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--twitter-border); padding-bottom: 0.75rem;">
          <h3 style="font-size: 1.15rem; margin: 0; display: flex; align-items: center; gap: 0.5rem; font-weight: 800;">
            <span>Community Timeline</span>
            <span style="font-size: 0.75rem; background: var(--twitter-bg-gray); color: var(--twitter-text-sub); border: 1px solid var(--twitter-border); padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 700;"><%= posts ? posts.length : 0 %> posts</span>
          </h3>
          <div class="tab-pills-bar">
            <button class="tab-pill active">For You</button>
            <button class="tab-pill">Following</button>
          </div>
        </div>

        <div class="feed-stream-container" style="display: flex; flex-direction: column; gap: 0.85rem;">
          <% if (posts && posts.length > 0) { %>
            <% posts.forEach(post => { %>
              <div class="tweet-card" style="padding: 1rem 1.15rem; border-radius: 12px; border: 1px solid var(--twitter-border); background: #FFFFFF;">
                
                <!-- Tweet Post Header -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                  <div style="display: flex; align-items: center; gap: 0.65rem;">
                    <a href="/<%= post.user.handle.replace('@', '') %>" style="text-decoration: none;">
                      <% if (post.user.avatar) { %>
                        <img src="<%= post.user.avatar %>" alt="<%= post.user.name %>" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(post.user.name || 'User') %>&background=0F1419&color=fff&size=128';">
                      <% } else { %>
                        <div style="width: 38px; height: 38px; border-radius: 50%; background: #0F1419; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.95rem; flex-shrink: 0;">
                          <%= (post.user.name || 'U').charAt(0).toUpperCase() %>
                        </div>
                      <% } %>
                    </a>
                    <div>
                      <div style="display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; line-height: 1.25;">
                        <a href="/<%= post.user.handle.replace('@', '') %>" style="text-decoration: none; color: var(--twitter-text-main); font-weight: 700; font-size: 0.925rem;">
                          <%= post.user.name %>
                        </a>
                        <% if (post.user.isVerified) { %>
                          <span class="verified-badge" title="Verified Athlete">
                            <i data-lucide="check-circle-2" style="width: 14px; height: 14px; fill: var(--twitter-blue); color: #FFFFFF;"></i>
                          </span>
                        <% } %>
                        <a href="/<%= post.user.handle.replace('@', '') %>" style="text-decoration: none; font-size: 0.825rem; color: var(--twitter-text-sub);">
                          <%= post.user.handle %>
                        </a>
                        <span style="font-size: 0.75rem; color: var(--twitter-text-sub);">·</span>
                        <span style="font-size: 0.8rem; color: var(--twitter-text-sub);"><%= post.time %></span>
                      </div>
                    </div>
                  </div>
                  <a href="/post/<%= post.id %>" style="color: var(--twitter-text-sub); padding: 0.25rem; border-radius: 9999px;" title="View thread"><i data-lucide="external-link" style="width: 15px; height: 15px;"></i></a>
                </div>

                <!-- Tweet Body Text & Media -->
                <div style="padding-left: 0; margin-bottom: 0.5rem;">
                  <% if (post.content) { %>
                    <a href="/post/<%= post.id %>" style="text-decoration: none; color: var(--twitter-text-main); display: block;">
                      <p style="margin-bottom: 0.65rem; font-size: 0.95rem; line-height: 1.5; word-break: break-word;"><%= post.content %></p>
                    </a>
                  <% } %>
                  <% if (post.image) { %>
                    <a href="/post/<%= post.id %>" style="display: block; margin-top: 0.5rem;">
                      <div style="border-radius: 12px; overflow: hidden; max-height: 380px; border: 1px solid var(--twitter-border); background: #000000;">
                        <img src="<%= post.image %>" alt="Post Image" style="width: 100%; height: auto; object-fit: contain; display: block; max-height: 380px;" onerror="this.parentElement.style.display='none';">
                      </div>
                    </a>
                  <% } %>
                </div>

                <!-- Twitter Action Row (Reply, Retweet, Like, Share) -->
                <div class="tweet-actions-row">
                  <button class="tweet-action-btn" title="Replies" onclick="window.location.href='/post/<%= post.id %>'">
                    <i data-lucide="message-circle" style="width: 16px; height: 16px;"></i>
                    <span><%= post.comments %></span>
                  </button>
                  <button class="tweet-action-btn action-retweet" title="Repost / Share" onclick="navigator.clipboard?.writeText(window.location.origin + '/post/<%= post.id %>'); alert('Post link copied to clipboard!');">
                    <i data-lucide="repeat" style="width: 16px; height: 16px;"></i>
                    <span><%= post.shares || 0 %></span>
                  </button>
                  <button class="tweet-action-btn action-like" title="Like" onclick="this.classList.toggle('text-rose-500')">
                    <i data-lucide="heart" style="width: 16px; height: 16px;"></i>
                    <span><%= post.likes %></span>
                  </button>
                  <button class="tweet-action-btn" title="Share" onclick="if(navigator.share){navigator.share({title: '<%= post.user.name %> on Beyounge', url: '/post/<%= post.id %>'});}else{navigator.clipboard?.writeText(window.location.origin + '/post/<%= post.id %>'); alert('Copied link!');}">
                    <i data-lucide="share" style="width: 15px; height: 15px;"></i>
                  </button>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="tweet-card" style="padding: 2.5rem; text-align: center; border-radius: 14px; color: var(--twitter-text-sub);">
              <i data-lucide="feather" style="width: 28px; height: 28px; color: var(--twitter-text-sub); margin-bottom: 0.5rem;"></i>
              <p style="margin: 0; font-size: 0.95rem; font-weight: 500;">No posts in community timeline yet.</p>
            </div>
          <% } %>
          
          <div class="glass-card" style="text-align: center; padding: 3rem 2rem; margin-top: 2rem; border: 1px solid var(--border-subtle); background: #F8FAFC;">
            <div style="width: 60px; height: 60px; background: #ECFDF5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
              <i data-lucide="smartphone" style="color: var(--primary-emerald); width: 30px; height: 30px;"></i>
            </div>
            <h3 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Unlock the Full Experience</h3>
            <p style="color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto; line-height: 1.6;">
              Download the Beyounge app to see more posts, track your macros, and get personalized AI coaching.
            </p>
            <a href="https://play.google.com/store/apps/details?id=com.beyounge.app" target="_blank" rel="noopener" class="btn btn-primary" style="display: inline-flex; justify-content: center; width: auto; padding: 0.85rem 2rem;">
              Download App Now
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>

  <div class="video-modal" id="videoModal">
    <div class="video-modal-content">
      <button class="video-modal-close" id="closeVideoModal"><i data-lucide="x"></i></button>
      <video id="reelVideo" controls autoplay playsinline class="video-player"></video>
    </div>
  </div>

  <style>
    /* Custom Hide Scrollbar */
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .reel-card {
       flex: 0 0 180px;
       height: 300px;
       position: relative;
       border-radius: 20px;
       overflow: hidden;
       scroll-snap-align: start;
       cursor: pointer;
       background: #000;
       border: 1px solid rgba(255,255,255,0.1);
    }
    .reel-thumbnail {
       width: 100%;
       height: 100%;
       object-fit: cover;
       transition: transform 0.5s ease;
    }
    .reel-card:hover .reel-thumbnail {
      transform: scale(1.1);
    }
    .reel-card:hover .reel-play-overlay {
      opacity: 1 !important;
    }

    .reel-play-overlay {
       position: absolute;
       inset: 0;
       display: flex;
       align-items: center;
       justify-content: center;
       opacity: 0;
       transition: opacity 0.3s;
       z-index: 3;
       background: rgba(0,0,0,0.2);
    }
    .reel-play-btn {
       width: 50px;
       height: 50px;
       border-radius: 50%;
       background: rgba(255,255,255,0.2);
       backdrop-filter: blur(4px);
       display: flex;
       align-items: center;
       justify-content: center;
       border: 1px solid rgba(255,255,255,0.3);
    }

    .video-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.95);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .video-modal.active {
      display: flex;
    }
    .video-modal-content {
      position: relative;
      width: 100%;
      max-width: 400px;
      height: 80vh;
      background: #000;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    }
    .video-player {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .video-modal-close {
      position: absolute;
      top: 15px;
      right: 15px;
      z-index: 10;
      background: rgba(0,0,0,0.5);
      border: none;
      color: white;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s;
    }
    .video-modal-close:hover {
      background: rgba(255,255,255,0.1);
    }

    .post-action-btn:hover {
      color: var(--primary-emerald) !important;
    }
  </style>

  <%- include('../partials/footer') %>

  <!-- Icons Script -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons();

    // Reel Player Logic
    const videoModal = document.getElementById('videoModal');
    const reelVideo = document.getElementById('reelVideo');
    const closeVideoModal = document.getElementById('closeVideoModal');
    const reelCards = document.querySelectorAll('.reel-card');

    reelCards.forEach(card => {
      card.addEventListener('click', () => {
        const videoUrl = card.getAttribute('data-video');
        if (videoUrl) {
          reelVideo.src = videoUrl;
          videoModal.classList.add('active');
          document.body.style.overflow = 'hidden';
          reelVideo.play();
        }
      });
    });

    function stopReel() {
      videoModal.classList.remove('active');
      reelVideo.pause();
      reelVideo.src = '';
      document.body.style.overflow = '';
    }

    closeVideoModal.addEventListener('click', stopReel);
    videoModal.addEventListener('click', (e) => {
      if (e.target === videoModal) stopReel();
    });
  </script>
</body>
</html>

