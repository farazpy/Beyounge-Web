<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section" style="padding-top: 9rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-purple"><i data-lucide="image"></i> Brand Assets</span>
      <h1 class="section-title">Beyounge Press Kit & Media Assets</h1>
      <p style="font-size: 1.25rem;">
        Official logos, primary brand color codes, app screen mockups, and company press releases.
      </p>
    </div>

    <!-- Color Palette Section -->
    <div style="margin-bottom: 4rem;">
      <h2 style="margin-bottom: 1.5rem;">Official Brand Colors</h2>
      <div class="grid-4">
        <div class="glass-card" style="text-align: center;">
          <div style="width: 100%; height: 80px; background: #10B981; border-radius: var(--radius-md); margin-bottom: 1rem; "></div>
          <h4 style="margin-bottom: 0.25rem;">Vibrant Orange</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">#10B981</p>
          <button class="btn btn-secondary btn-sm btn-copy" data-copy="#10B981" style="width: 100%;">
            <i data-lucide="copy"></i> Copy Hex
          </button>
        </div>

        <div class="glass-card" style="text-align: center;">
          <div style="width: 100%; height: 80px; background: #06B6D4; border-radius: var(--radius-md); margin-bottom: 1rem;"></div>
          <h4 style="margin-bottom: 0.25rem;">Glowing Cyan</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">#06B6D4</p>
          <button class="btn btn-secondary btn-sm btn-copy" data-copy="#06B6D4" style="width: 100%;">
            <i data-lucide="copy"></i> Copy Hex
          </button>
        </div>

        <div class="glass-card" style="text-align: center;">
          <div style="width: 100%; height: 80px; background: #8B5CF6; border-radius: var(--radius-md); margin-bottom: 1rem;"></div>
          <h4 style="margin-bottom: 0.25rem;">Electric Violet</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">#8B5CF6</p>
          <button class="btn btn-secondary btn-sm btn-copy" data-copy="#8B5CF6" style="width: 100%;">
            <i data-lucide="copy"></i> Copy Hex
          </button>
        </div>

        <div class="glass-card" style="text-align: center;">
          <div style="width: 100%; height: 80px; background: #07090E; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); margin-bottom: 1rem;"></div>
          <h4 style="margin-bottom: 0.25rem;">Obsidian Dark</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">#07090E</p>
          <button class="btn btn-secondary btn-sm btn-copy" data-copy="#07090E" style="width: 100%;">
            <i data-lucide="copy"></i> Copy Hex
          </button>
        </div>
      </div>
    </div>

    <!-- Logo & Vector Placeholders -->
    <div style="margin-bottom: 4rem;">
      <h2 style="margin-bottom: 1.5rem;">Logo Assets</h2>
      <div class="grid-2">
        <div class="glass-card" style="display: flex; align-items: center; justify-content: space-between; gap: 2rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div class="logo-icon" style="width: 54px; height: 54px; font-size: 1.5rem;">B</div>
            <div>
              <h3>Beyounge Primary Mark</h3>
              <p style="font-size: 0.85rem; color: var(--text-muted);">Vector SVG / High-Res PNG</p>
            </div>
          </div>
          <a href="/images/favicon.svg" download class="btn btn-primary btn-sm">
            <i data-lucide="download"></i> SVG
          </a>
        </div>

        <div class="glass-card" style="display: flex; align-items: center; justify-content: space-between; gap: 2rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div class="logo-icon" style="width: 54px; height: 54px; background: var(--primary-emerald); font-size: 1.5rem;">B</div>
            <div>
              <h3>Beyounge App Icon</h3>
              <p style="font-size: 0.85rem; color: var(--text-muted);">Google Play Store 512x512</p>
            </div>
          </div>
          <a href="/images/favicon.svg" download class="btn btn-primary btn-sm">
            <i data-lucide="download"></i> PNG
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
