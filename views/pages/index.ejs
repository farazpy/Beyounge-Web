<%- include('../partials/head') %>

<body>
  <%- include('../partials/header') %>

  <main style="padding-top: 80px; padding-bottom: 80px; background-color: var(--bg-surface); min-height: 100vh;">
    <div class="container feed-layout-container">
      
      <!-- Left Sidebar: App Landing & Navigation -->
      <aside class="feed-sidebar left-sidebar">
         <div class="glass-card" style="padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
               <div style="width: 40px; height: 40px; background: var(--primary-emerald); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.25rem;">B</div>
               <h2 style="font-size: 1.4rem; margin: 0;">Beyounge</h2>
            </div>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.5rem;">Your ultimate AI-powered fitness, nutrition, and wellness community.</p>
            <a href="/download" class="btn btn-primary" style="width: 100%; margin-bottom: 1.5rem; font-size: 0.95rem; padding: 0.75rem;">
              <i data-lucide="smartphone"></i> Get the App
            </a>
            
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
               <a href="/ai-coach" class="sidebar-link"><i data-lucide="bot"></i> AI Coach</a>
               <a href="/features" class="sidebar-link"><i data-lucide="zap"></i> Features</a>
               <a href="/benefits" class="sidebar-link"><i data-lucide="award"></i> Benefits</a>
               <a href="/blog" class="sidebar-link"><i data-lucide="file-text"></i> Blog</a>
            </div>
         </div>

         <!-- Top Features -->
         <div class="glass-card" style="padding: 1.5rem; border-radius: var(--radius-lg);">
            <h3 style="font-size: 1.05rem; margin-bottom: 1.25rem; font-weight: 700; color: var(--text-primary);">Why Beyounge?</h3>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem; font-size: 0.9rem; color: var(--text-secondary);">
               <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                  <i data-lucide="check-circle" style="color: var(--primary-emerald); width: 18px; margin-top: 2px;"></i> 
                  <span><strong>Hyper-Personalized</strong><br><span style="font-size: 0.8rem;">AI adapts to your progress</span></span>
               </li>
               <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                  <i data-lucide="camera" style="color: var(--primary-emerald); width: 18px; margin-top: 2px;"></i> 
                  <span><strong>Photo Macro Tracking</strong><br><span style="font-size: 0.8rem;">Snap food for instant macros</span></span>
               </li>
               <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
                  <i data-lucide="users" style="color: var(--primary-emerald); width: 18px; margin-top: 2px;"></i> 
                  <span><strong>Social Motivation</strong><br><span style="font-size: 0.8rem;">Train with the community</span></span>
               </li>
            </ul>
         </div>
      </aside>

      <!-- Main Feed Content -->
      <section class="feed-main">
         <!-- App Landing Hero Banner -->
         <div class="glass-card hero-banner">
            <span class="badge badge-emerald" style="margin-bottom: 1rem; padding: 0.35rem 0.85rem; font-size: 0.75rem;">New Release 2.0</span>
            <h1 style="font-size: clamp(1.8rem, 3vw, 2.5rem); margin-bottom: 1rem; line-height: 1.15; letter-spacing: -0.02em;">Transform your body with <br><span class="gradient-text">AI Precision</span></h1>
            <p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 500px;">Join thousands of athletes sharing their progress, routines, and meals in real-time. Let AI guide your daily wellness.</p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
               <a href="/download" class="btn btn-primary"><i data-lucide="user-plus"></i> Join Community</a>
               <a href="/features" class="btn btn-secondary">Explore Platform</a>
            </div>
         </div>

         <!-- Reels Section -->
         <div style="margin-bottom: 2.5rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 700;">
              <i data-lucide="play-circle" style="color: var(--primary-emerald);"></i> Trending Reels
            </h3>
            
            <div class="reels-container hide-scrollbar">
              <% reels.forEach(reel => { %>
                <div class="reel-card">
                  <img src="<%= reel.video %>" alt="Reel by <%= reel.user %>" class="reel-thumbnail">
                  <div class="reel-gradient"></div>
                  
                  <div class="reel-info">
                    <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem;">
                      <img src="<%= reel.avatar %>" alt="<%= reel.user %>" class="reel-avatar">
                      <span class="reel-username"><%= reel.user %></span>
                    </div>
                    <div class="reel-views">
                      <i data-lucide="eye" style="width: 12px; height: 12px;"></i> <%= reel.views %>
                    </div>
                  </div>

                  <div class="reel-play-overlay">
                     <div class="reel-play-btn">
                        <i data-lucide="play" style="color: white; width: 20px; height: 20px; margin-left: 2px;"></i>
                     </div>
                  </div>
                </div>
              <% }); %>
            </div>
         </div>

         <!-- Posts Feed -->
         <div>
            <h3 style="font-size: 1.15rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 700;">
              <i data-lucide="activity" style="color: var(--primary-emerald);"></i> Community Activity
            </h3>

            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
              <% posts.forEach(post => { %>
                <div class="glass-card post-card">
                  <div class="post-header">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                      <img src="<%= post.user.avatar %>" alt="<%= post.user.name %>" class="post-avatar">
                      <div>
                        <h4 class="post-name"><%= post.user.name %></h4>
                        <span class="post-meta"><%= post.user.handle %> • <%= post.time %></span>
                      </div>
                    </div>
                    <button class="icon-btn"><i data-lucide="more-horizontal"></i></button>
                  </div>

                  <div style="margin-bottom: 1rem;">
                    <p class="post-text"><%= post.content %></p>
                    <% if(post.image) { %>
                      <div class="post-image-container">
                        <img src="<%= post.image %>" alt="Post Image" class="post-image">
                      </div>
                    <% } %>
                  </div>

                  <div class="post-actions">
                    <button class="post-action-btn">
                      <i data-lucide="heart"></i> <span><%= post.likes %></span>
                    </button>
                    <button class="post-action-btn">
                      <i data-lucide="message-circle"></i> <span><%= post.comments %></span>
                    </button>
                    <button class="post-action-btn" style="margin-left: auto;">
                      <i data-lucide="share-2"></i>
                    </button>
                  </div>
                </div>
              <% }); %>
              
              <div class="glass-card" style="text-align: center; padding: 3rem 2rem; margin-top: 2rem; border: 1px solid var(--border-subtle); background: #F8FAFC;">
                <div style="width: 60px; height: 60px; background: #ECFDF5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
                  <i data-lucide="smartphone" style="color: var(--primary-emerald); width: 30px; height: 30px;"></i>
                </div>
                <h3 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Unlock the Full Experience</h3>
                <p style="color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto; line-height: 1.6;">
                  Download the Beyounge app to see more posts, track your macros, and get personalized AI coaching.
                </p>
                <a href="/download" class="btn btn-primary" style="display: inline-flex; justify-content: center; width: auto; padding: 0.85rem 2rem;">
                  Download App Now
                </a>
              </div>
            </div>
         </div>
      </section>

      <!-- Right Sidebar: Suggested & Trending -->
      <aside class="feed-sidebar right-sidebar">
         <div class="glass-card" style="padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.05rem; margin-bottom: 1.25rem; font-weight: 700;">Suggested Athletes</h3>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
               <div style="display: flex; align-items: center; justify-content: space-between;">
                  <div style="display: flex; align-items: center; gap: 0.65rem;">
                     <img src="https://i.pravatar.cc/150?u=a1" alt="Athlete" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover;">
                     <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary);">Marcus R.</span>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Powerlifter</span>
                     </div>
                  </div>
                  <button class="btn btn-secondary btn-sm" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: 20px;">Follow</button>
               </div>
               <div style="display: flex; align-items: center; justify-content: space-between;">
                  <div style="display: flex; align-items: center; gap: 0.65rem;">
                     <img src="https://i.pravatar.cc/150?u=a2" alt="Athlete" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover;">
                     <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary);">Elena G.</span>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Yoga Instructor</span>
                     </div>
                  </div>
                  <button class="btn btn-secondary btn-sm" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: 20px;">Follow</button>
               </div>
               <div style="display: flex; align-items: center; justify-content: space-between;">
                  <div style="display: flex; align-items: center; gap: 0.65rem;">
                     <img src="https://i.pravatar.cc/150?u=a3" alt="Athlete" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover;">
                     <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary);">David K.</span>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Crossfit</span>
                     </div>
                  </div>
                  <button class="btn btn-secondary btn-sm" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: 20px;">Follow</button>
               </div>
            </div>
         </div>

         <div class="glass-card" style="padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.05rem; margin-bottom: 1.25rem; font-weight: 700;">Trending Tags</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
               <span style="padding: 0.35rem 0.85rem; background: #F1F5F9; color: var(--text-primary); font-size: 0.8rem; border-radius: 20px; font-weight: 600; cursor: pointer;">#HIIT</span>
               <span style="padding: 0.35rem 0.85rem; background: #F1F5F9; color: var(--text-primary); font-size: 0.8rem; border-radius: 20px; font-weight: 600; cursor: pointer;">#MealPrep</span>
               <span style="padding: 0.35rem 0.85rem; background: #ECFDF5; color: var(--primary-emerald-dark); font-size: 0.8rem; border-radius: 20px; font-weight: 600; cursor: pointer;">#Transformation</span>
               <span style="padding: 0.35rem 0.85rem; background: #F1F5F9; color: var(--text-primary); font-size: 0.8rem; border-radius: 20px; font-weight: 600; cursor: pointer;">#YogaFlow</span>
               <span style="padding: 0.35rem 0.85rem; background: #F1F5F9; color: var(--text-primary); font-size: 0.8rem; border-radius: 20px; font-weight: 600; cursor: pointer;">#MarathonPrep</span>
            </div>
         </div>

         <div class="glass-card" style="padding: 1.5rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.05rem; margin-bottom: 1.25rem; font-weight: 700;">Weekly Challenge</h3>
            <div style="display: flex; align-items: flex-start; gap: 1rem;">
               <div style="width: 48px; height: 48px; background: #FFFBEB; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <i data-lucide="flame" style="color: #D97706; width: 24px; height: 24px;"></i>
               </div>
               <div>
                  <h4 style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.25rem;">10K Steps Daily</h4>
                  <p style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.75rem;">Join 15,203 others in completing this week's movement goal.</p>
                  <button class="btn btn-primary" style="padding: 0.4rem 1rem; font-size: 0.8rem; width: 100%;">Join Challenge</button>
               </div>
            </div>
         </div>
      </aside>
    </div>
  </main>

  <style>
    .hover-emerald:hover {
       color: var(--primary-emerald);
    }

    .feed-layout-container {
       display: flex;
       gap: 2rem;
       align-items: flex-start;
       padding-top: 1.5rem;
    }

    .feed-sidebar {
       position: sticky;
       top: 100px;
       display: flex;
       flex-direction: column;
       height: max-content;
    }

    .left-sidebar {
       flex: 0 0 260px;
    }

    .right-sidebar {
       flex: 0 0 280px;
    }

    .feed-main {
       flex: 1;
       min-width: 0; 
    }

    .sidebar-link {
       display: flex;
       align-items: center;
       gap: 0.75rem;
       font-size: 0.95rem;
       font-weight: 600;
       color: var(--text-secondary);
       padding: 0.65rem 0.75rem;
       border-radius: var(--radius-md);
       transition: all 0.2s;
    }
    .sidebar-link i {
       color: var(--primary-emerald);
       width: 20px;
       height: 20px;
    }
    .sidebar-link:hover {
       background: rgba(16, 185, 129, 0.08);
       color: var(--primary-emerald);
    }

    .hero-banner {
       padding: 2.5rem;
       border-radius: var(--radius-xl);
       margin-bottom: 2.5rem;
       background: #F0FDF4;
       border: 1px solid rgba(16, 185, 129, 0.2);
       
       position: relative;
       overflow: hidden;
    }
    .hero-banner::after {
       content: '';
       position: absolute;
       right: -80px;
       top: -80px;
       width: 300px;
       height: 300px;
       
       border-radius: 50%;
       pointer-events: none;
    }

    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .reels-container {
       display: flex;
       gap: 1rem;
       overflow-x: auto;
       padding-bottom: 1rem;
       scroll-snap-type: x mandatory;
       -webkit-overflow-scrolling: touch;
    }

    .reel-card {
       flex: 0 0 150px;
       height: 260px;
       position: relative;
       border-radius: var(--radius-md);
       overflow: hidden;
       scroll-snap-align: start;
       
       cursor: pointer;
    }
    .reel-thumbnail {
       width: 100%;
       height: 100%;
       object-fit: cover;
       transition: transform 0.3s ease;
    }
    .reel-card:hover .reel-thumbnail { transform: scale(1.05); }
    
    .reel-gradient {
       position: absolute;
       inset: 0;
       background: rgba(0,0,0,0.3);
       pointer-events: none;
    }

    .reel-info {
       position: absolute;
       bottom: 12px;
       left: 12px;
       right: 12px;
       color: white;
       z-index: 2;
    }
    .reel-avatar {
       width: 24px;
       height: 24px;
       border-radius: 50%;
       border: 1px solid white;
    }
    .reel-username {
       font-size: 0.8rem;
       font-weight: 600;
       white-space: nowrap;
       overflow: hidden;
       text-overflow: ellipsis;
    }
    .reel-views {
       font-size: 0.75rem;
       color: rgba(255,255,255,0.9);
       display: flex;
       align-items: center;
       gap: 0.25rem;
       margin-top: 0.15rem;
    }

    .reel-play-overlay {
       position: absolute;
       inset: 0;
       display: flex;
       align-items: center;
       justify-content: center;
       opacity: 0;
       transition: opacity 0.2s;
       z-index: 3;
    }
    .reel-card:hover .reel-play-overlay { opacity: 1; }
    
    .reel-play-btn {
       width: 44px;
       height: 44px;
       border-radius: 50%;
       background: rgba(255,255,255,0.25);
       
       display: flex;
       align-items: center;
       justify-content: center;
    }

    .post-card {
       padding: 1.5rem;
       border-radius: var(--radius-lg);
    }
    .post-header {
       display: flex;
       justify-content: space-between;
       align-items: flex-start;
       margin-bottom: 1.25rem;
    }
    .post-avatar {
       width: 46px;
       height: 46px;
       border-radius: 50%;
       object-fit: cover;
    }
    .post-name {
       font-size: 1rem;
       font-weight: 700;
       margin: 0;
       color: var(--text-primary);
    }
    .post-meta {
       font-size: 0.85rem;
       color: var(--text-muted);
    }
    .post-text {
       margin-bottom: 1.25rem;
       color: var(--text-primary);
       font-size: 1.05rem;
       line-height: 1.6;
    }
    .post-image-container {
       border-radius: var(--radius-md);
       overflow: hidden;
       max-height: 450px;
    }
    .post-image {
       width: 100%;
       height: auto;
       object-fit: cover;
       display: block;
    }
    .post-actions {
       display: flex;
       align-items: center;
       gap: 1.75rem;
       border-top: 1px solid var(--border-subtle);
       padding-top: 1.25rem;
       margin-top: 0.75rem;
       color: var(--text-muted);
    }
    .post-action-btn {
       display: flex;
       align-items: center;
       gap: 0.5rem;
       background: none;
       border: none;
       color: inherit;
       font-size: 0.95rem;
       font-weight: 600;
       cursor: pointer;
       transition: color 0.2s;
    }
    .post-action-btn i {
       width: 20px;
       height: 20px;
    }
    .post-action-btn:hover {
       color: var(--primary-emerald);
    }
    .icon-btn {
       background: none;
       border: none;
       color: var(--text-muted);
       cursor: pointer;
       transition: color 0.2s;
    }
    .icon-btn:hover {
       color: var(--primary-emerald);
    }

    /* Responsive Breakpoints */
    @media (max-width: 1100px) {
       .right-sidebar { display: none; }
       .feed-layout-container { justify-content: center; }
       .left-sidebar { flex: 0 0 280px; }
       .feed-main { max-width: 700px; }
    }

    @media (max-width: 820px) {
       .feed-layout-container { 
          flex-direction: column; 
          padding-top: 1rem;
       }
       .left-sidebar { 
          display: none; 
       }
       .feed-main { max-width: 100%; }
       .hero-banner {
          padding: 1.75rem;
       }
       .hero-banner h1 {
          font-size: 1.75rem;
       }
    }
  </style>

  <%- include('../partials/footer') %>

  <!-- Icons Script -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
