<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section" style="padding-top: 9rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-emerald"><i data-lucide="layers"></i> Feature Suite</span>
      <h1 class="section-title">Engineered for Maximum Physical Gains</h1>
      <p style="font-size: 1.25rem;">
        Discover how Beyounge integrates exercise science, computer vision, and machine learning into a single fluid Android application.
      </p>
    </div>

    <!-- Feature 1: AI Coach -->
    <div class="glass-card grid-2 reveal-on-scroll" style="margin-bottom: 3rem; align-items: center;">
      <div>
        <span class="badge badge-purple" style="margin-bottom: 1rem;">Core Intelligence</span>
        <h2 style="margin-bottom: 1rem;">Personalized AI Workout Coach</h2>
        <p style="margin-bottom: 1.25rem;">
          No more guessing reps or weight jumps. Beyounge’s neural network computes your historical performance, rate of perceived exertion (RPE), and recovery readiness to generate custom workouts every session.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-secondary);">
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Dynamic RPE & weight progression recommendations</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Automatic deload week triggering upon CNS fatigue detection</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Custom equipment filters (Gym, Home, Dumbbells only, Bodyweight)</li>
        </ul>
      </div>
      <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); padding: 2rem; border-radius: var(--radius-lg);">
        <div class="app-card-ai">
          <div class="app-card-ai-title"><i data-lucide="bot"></i> AI Coach Live Log</div>
          <p class="app-card-ai-body">"Bar speed on Barbell Squat Set 3 was 0.42 m/s. Neural recovery is high. Increasing target load to 102.5 kg for final set."</p>
        </div>
      </div>
    </div>

    <!-- Feature 2: Workout Builder & Video Library -->
    <div class="glass-card grid-2 reveal-on-scroll" style="margin-bottom: 3rem; align-items: center;">
      <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); padding: 2rem; border-radius: var(--radius-lg);">
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="app-workout-card">
            <div class="app-workout-icon"><i data-lucide="video"></i></div>
            <div>
              <h5 style="color: var(--text-primary); font-size: 0.95rem;">Barbell Romanian Deadlift</h5>
              <p style="font-size: 0.8rem; color: var(--text-muted);">HD 60fps Form Video • Glutes & Hamstrings Focus</p>
            </div>
          </div>
          <div class="app-workout-card">
            <div class="app-workout-icon" style="background: rgba(16,185,129,0.2); color:#34D399;"><i data-lucide="layers"></i></div>
            <div>
              <h5 style="color: var(--text-primary); font-size: 0.95rem;">SuperSet Alpha</h5>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Cable Flyes + Push-Ups • 60s Rest Timer</p>
            </div>
          </div>
        </div>
      </div>
      <div>
        <span class="badge badge-emerald" style="margin-bottom: 1rem;">Flexibility</span>
        <h2 style="margin-bottom: 1rem;">Custom Workout Builder & 1,000+ Exercise Library</h2>
        <p style="margin-bottom: 1.25rem;">
          Design multi-phase workout templates with drag-and-drop supersets, drop sets, and pyramid rest timers. Access 1,000+ HD videos showing perfect anatomical execution.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-secondary);">
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Multi-angle 4K execution breakdown videos</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Custom warm-up set calculator</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Exercise substitution suggestions for injured joints</li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Photo Macro Scanner & Meal Planner -->
    <div class="glass-card grid-2 reveal-on-scroll" style="margin-bottom: 3rem; align-items: center;">
      <div>
        <span class="badge badge-cyan" style="margin-bottom: 1rem;">Smart Nutrition</span>
        <h2 style="margin-bottom: 1rem;">Camera Photo Macro Recognition & Meal Planner</h2>
        <p style="margin-bottom: 1.25rem;">
          Point your smartphone camera at your plate. Beyounge automatically estimates weight density, identifies ingredients, and records calories, protein, carbs, and fats instantly.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-secondary);">
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> AI Photo calorie recognition with 92%+ precision</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Smart hydration reminders and water tracking</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Custom macro ratios for bulking, cutting, or maintenance</li>
        </ul>
      </div>
      <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); padding: 2rem; border-radius: var(--radius-lg);">
        <div class="app-metric-grid">
          <div class="app-metric-card">
            <span class="app-metric-label">Daily Calories</span>
            <div class="app-metric-val">2,240 / 2,400</div>
          </div>
          <div class="app-metric-card">
            <span class="app-metric-label">Protein Logged</span>
            <div class="app-metric-val">172g / 180g</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 4: Analytics & PR Tracking -->
    <div class="glass-card grid-2 reveal-on-scroll" style="margin-bottom: 3rem; align-items: center;">
      <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); padding: 2rem; border-radius: var(--radius-lg);">
        <div style="text-align: center; padding: 1rem;">
          <i data-lucide="award" style="width: 48px; height: 48px; color: #F59E0B; margin-bottom: 0.5rem;"></i>
          <h4 style="color: var(--text-primary);">Personal Record Milestone</h4>
          <p style="font-size: 0.85rem; color: #34D399; margin-top: 0.25rem;">Deadlift 1RM: 210 kg (New All-time Best)</p>
        </div>
      </div>
      <div>
        <span class="badge badge-purple" style="margin-bottom: 1rem;">Analytics</span>
        <h2 style="margin-bottom: 1rem;">PR Analytics & Body Measurement Logs</h2>
        <p style="margin-bottom: 1.25rem;">
          Visualize strength curves, total volume tonnage, estimated 1-Rep Max trends, body fat percentage curves, and progress photo comparisons over time.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-secondary);">
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Automatic 1RM estimation formulas (Epley, Brzycki)</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Side-by-side photo comparison timeline</li>
          <li style="display: flex; align-items: center; gap: 0.5rem;"><i data-lucide="check-circle" style="color:#10B981;"></i> Body measurement logging (chest, waist, arms, legs)</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
