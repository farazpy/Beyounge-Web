<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section" style="padding-top: 9rem;">
  <div class="container">
    <div class="glass-card" style="padding: 4rem 2rem; background: var(--bg-surface); border: 1px solid var(--border-highlight); border-radius: var(--radius-xl);">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;">
        <div>
          <span class="badge badge-emerald" style="margin-bottom: 1rem;">
            <i data-lucide="smartphone"></i> Android Official Release
          </span>
          <h1 style="font-size: clamp(2.5rem, 4vw, 3.75rem); margin-bottom: 1rem; line-height: 1.1;">
            Get Beyounge for Android
          </h1>
          <p style="font-size: 1.15rem; color: var(--text-secondary); margin-bottom: 2rem;">
            Experience the full power of Beyounge’s adaptive AI coach, photo nutrition scanner, and offline gym logging. Free download on Google Play.
          </p>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
            <a href="https://play.google.com" target="_blank" rel="noopener" class="btn btn-primary btn-lg btn-playstore btn-glow">
              <i data-lucide="play"></i>
              <span>Download on Google Play</span>
            </a>
          </div>

          <!-- Coming Soon Badges -->
          <div style="display: flex; gap: 1rem; align-items: center; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
            <div style="font-size: 0.85rem; color: var(--text-muted);">Coming Soon:</div>
            <span class="badge badge-purple" style="opacity: 0.8;"><i data-lucide="apple"></i> iOS App Store</span>
            <span class="badge badge-cyan" style="opacity: 0.8;"><i data-lucide="globe"></i> Web App</span>
          </div>
        </div>

        <!-- QR Code Placeholder Card -->
        <div style="display: flex; justify-content: center;">
          <div class="glass-card" style="text-align: center; width: 280px; padding: 2rem; background: #FFFFFF; border: 1px solid var(--border-subtle);">
            <div style="width: 180px; height: 180px; background: #FFFFFF; border-radius: 16px; margin: 0 auto 1.25rem auto; display: flex; align-items: center; justify-content: center; padding: 1rem;">
              <!-- Simulated QR SVG -->
              <svg viewBox="0 0 100 100" style="width: 100%; height: 100%; fill: #07090E;">
                <path d="M0,0 h30 v30 h-30 z M10,10 h10 v10 h-10 z M70,0 h30 v30 h-30 z M80,10 h10 v10 h-10 z M0,70 h30 v30 h-30 z M10,80 h10 v10 h-10 z M40,10 h20 v10 h-20 z M40,40 h20 v20 h-20 z M70,40 h20 v10 h-20 z M10,40 h20 v20 h-20 z M70,70 h10 v10 h-10 z M90,80 h10 v20 h-10 z M50,80 h20 v10 h-20 z"/>
              </svg>
            </div>
            <h4 style="font-size: 1rem; color: var(--text-primary); margin-bottom: 0.25rem;">Scan to Download</h4>
            <p style="font-size: 0.8rem; color: var(--text-muted);">Point your Android camera to download directly</p>
          </div>
        </div>
      </div>
    </div>

    <!-- System Requirements -->
    <div style="margin-top: 4rem;">
      <h2 style="text-align: center; margin-bottom: 2rem;">System Requirements</h2>
      <div class="grid-3">
        <div class="glass-card">
          <div class="feature-icon-box"><i data-lucide="cpu"></i></div>
          <h3>Operating System</h3>
          <p>Android 8.0 (Oreo) or higher. Optimized for Android 14 & 15.</p>
        </div>

        <div class="glass-card">
          <div class="feature-icon-box feature-icon-purple"><i data-lucide="hard-drive"></i></div>
          <h3>Storage Space</h3>
          <p>65 MB initial download. Local offline database scales automatically.</p>
        </div>

        <div class="glass-card">
          <div class="feature-icon-box feature-icon-cyan"><i data-lucide="heart-pulse"></i></div>
          <h3>Sensors & Sync</h3>
          <p>Compatible with Android Health Connect, Google Fit, Bluetooth HR straps, and smartwatch sensors.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
