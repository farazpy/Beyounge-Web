      gap: 0.35rem;
      transition: color 0.2s;
    }
    .breadcrumb-link:hover {
      color: var(--primary-emerald);
    }
    .breadcrumb-link i {
      width: 14px;
      height: 14px;
    }
    .breadcrumb-separator {
      color: #CBD5E1;
    }
    .breadcrumb-current {
      color: #0F172A;
      font-weight: 600;
    }

    /* Header */
    .legal-header {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 24px;
      padding: 2.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }
    .legal-badge-wrapper {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .legal-title {
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      font-weight: 800;
      color: #0F172A;
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    .legal-subtitle {
      font-size: 1.1rem;
      line-height: 1.65;
      color: #475569;
      max-width: 860px;
      margin-bottom: 1.75rem;
    }

    /* Meta Bar */
    .legal-meta-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #F1F5F9;
      flex-wrap: wrap;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .meta-item i {
      width: 22px;
      height: 22px;
      color: var(--primary-emerald);
      flex-shrink: 0;
    }
    .meta-label {
      display: block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94A3B8;
      font-weight: 700;
    }
    .meta-value {
      display: block;
      font-size: 0.95rem;
      color: #0F172A;
      font-weight: 700;
    }
    .meta-actions {
      display: flex;
      gap: 0.75rem;
      margin-left: auto;
    }
    .btn-meta-action {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1rem;
      border-radius: 10px;
      background: #F1F5F9;
      border: 1px solid #E2E8F0;
      color: #334155;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-meta-action:hover {
      background: #E2E8F0;
      color: #0F172A;
    }
    .btn-meta-action i {
      width: 16px;
      height: 16px;
    }

    /* Summary Card */
    .summary-section {
      margin-bottom: 2rem;
    }
    .summary-card {
      background: linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 100%);
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: 20px;
      padding: 2rem;
    }
    .summary-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .summary-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--primary-emerald);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .summary-icon i {
      width: 22px;
      height: 22px;
    }
    .summary-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: #064E3B;
      margin: 0;
    }
    .summary-subtitle {
      font-size: 0.9rem;
      color: #047857;
      margin: 0.2rem 0 0 0;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .summary-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      background: rgba(255, 255, 255, 0.75);
      padding: 1rem 1.25rem;
      border-radius: 14px;
      border: 1px solid rgba(16, 185, 129, 0.15);
    }
    .summary-bullet-icon {
      color: var(--primary-emerald);
      margin-top: 2px;
      flex-shrink: 0;
    }
    .summary-bullet-icon i {
      width: 18px;
      height: 18px;
    }
    .summary-item strong {
      display: block;
      font-size: 0.95rem;
      color: #064E3B;
      margin-bottom: 0.25rem;
    }
    .summary-item p {
      font-size: 0.875rem;
      line-height: 1.5;
      color: #334155;
      margin: 0;
    }

    /* Mobile Table of Contents */
    .mobile-toc-wrapper {
      display: none;
      margin-bottom: 1.5rem;
    }
    .mobile-toc-trigger {
      width: 100%;
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.95rem;
      font-weight: 700;
      color: #0F172A;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .toc-trigger-left {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .toc-trigger-left i {
      width: 20px;
      height: 20px;
      color: var(--primary-emerald);
    }
    .toc-chevron {
      width: 18px;
      height: 18px;
      color: #64748B;
      transition: transform 0.2s ease;
    }
    .mobile-toc-dropdown {
      display: none;
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-top: none;
      border-radius: 0 0 14px 14px;
      padding: 1rem 1.25rem;
    }
    .mobile-toc-dropdown.active {
      display: block;
    }
    .toc-chevron.rotate {
      transform: rotate(180deg);
    }
    .toc-mobile-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .toc-mobile-link {
      display: block;
      padding: 0.5rem 0.75rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #334155;
      text-decoration: none;
      transition: background 0.2s;
    }
    .toc-mobile-link:hover, .toc-mobile-link:active {
      background: rgba(16, 185, 129, 0.08);
      color: var(--primary-emerald);
    }

    /* Two-Column Layout */
    .legal-layout {
      display: grid;
      grid-template-columns: 310px 1fr;
      gap: 2.5rem;
      align-items: flex-start;
    }

    /* Desktop Sidebar */
    .legal-sidebar {
      position: sticky;
      top: 100px;
    }
    .toc-card {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 1.5rem;
      box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    }
    .toc-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 800;
      color: #64748B;
      padding-bottom: 1rem;
      border-bottom: 1px solid #F1F5F9;
      margin-bottom: 1rem;
    }
    .toc-header i {
      width: 16px;
      height: 16px;
      color: var(--primary-emerald);
    }
    .toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .toc-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.75rem;
      border-radius: 10px;
      font-size: 0.875rem;
      font-weight: 600;
      color: #475569;
      text-decoration: none;
      transition: all 0.2s ease;
      line-height: 1.35;
    }
    .toc-num {
      font-size: 0.75rem;
      font-weight: 700;
      color: #94A3B8;
      background: #F1F5F9;
      padding: 0.15rem 0.35rem;
      border-radius: 5px;
      min-width: 24px;
      text-align: center;
    }
    .toc-link:hover {
      background: rgba(16, 185, 129, 0.08);
      color: var(--primary-emerald);
      transform: translateX(3px);
    }
    .toc-link.active {
      background: rgba(16, 185, 129, 0.12);
      color: var(--primary-emerald);
      font-weight: 700;
    }
    .toc-link.active .toc-num {
      background: var(--primary-emerald);
      color: white;
    }

    .sidebar-help-box {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid #F1F5F9;
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }
    .help-box-icon {
      color: var(--primary-emerald);
      margin-top: 2px;
      flex-shrink: 0;
    }
    .help-box-icon i {
      width: 18px;
      height: 18px;
    }
    .help-box-content strong {
      display: block;
      font-size: 0.85rem;
      color: #0F172A;
      margin-bottom: 0.2rem;
    }
    .help-box-content p {
      font-size: 0.775rem;
      line-height: 1.4;
      color: #64748B;
      margin: 0 0 0.5rem 0;
    }
    .help-box-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--primary-emerald);
      text-decoration: none;
    }
    .help-box-link i {
      width: 14px;
      height: 14px;
    }
    .help-box-link:hover {
      text-decoration: underline;
    }

    /* Legal Content Body */
    .legal-content {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .content-intro-card {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.02);
      font-size: 1.05rem;
      line-height: 1.75;
      color: #334155;
    }
    .content-intro-card p:last-child {
      margin-bottom: 0;
    }

    .legal-section {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 24px;
      padding: 2.5rem;
      box-shadow: 0 4px 16px rgba(0,0,0,0.02);
      scroll-margin-top: 120px;
    }
    .section-title-wrapper {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid #F1F5F9;
    }
    .section-badge {
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary-emerald);
    }
    .section-title-wrapper h2 {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0F172A;
      margin: 0;
      line-height: 1.3;
    }
    .section-body {
      font-size: 1.025rem;
      line-height: 1.75;
      color: #334155;
    }
    .lead-text {
      font-size: 1.1rem;
      color: #0F172A;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }

    /* Lists */
    .styled-list {
      list-style: none;
      padding: 0;
      margin: 1.25rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .styled-list li {
      position: relative;
      padding-left: 1.75rem;
      line-height: 1.65;
    }
    .styled-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.6rem;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--primary-emerald);
    }

    /* Links */
    .inline-link {
      color: var(--primary-emerald);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.2s;
    }
    .inline-link:hover {
      color: var(--primary-emerald-dark, #059669);
    }

    /* Callout Boxes */
    .callout-box {
      border-radius: 16px;
      padding: 1.5rem;
      margin: 1.5rem 0;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .warning-callout {
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      color: #92400E;
    }
    .warning-callout .callout-icon {
      color: #D97706;
    }
    .info-callout {
      background: #F0FDF4;
      border: 1px solid #BBF7D0;
      color: #166534;
    }
    .info-callout .callout-icon {
      color: #16A34A;
    }
    .callout-icon {
      margin-top: 2px;
      flex-shrink: 0;
    }
    .callout-icon i {
      width: 24px;
      height: 24px;
    }
    .callout-content strong {
      display: block;
      font-size: 0.95rem;
      margin-bottom: 0.35rem;
      letter-spacing: 0.02em;
    }
    .callout-content p {
      font-size: 0.925rem;
      line-height: 1.6;
      margin: 0;
    }

    /* Prohibited Activities Grid */
    .prohibited-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin: 1.5rem 0;
    }
    .prohibited-item {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      padding: 1.25rem;
    }
    .prohibited-icon {
      color: #EF4444;
      margin-top: 2px;
      flex-shrink: 0;
    }
    .prohibited-icon i {
      width: 20px;
      height: 20px;
    }
    .prohibited-item strong {
      display: block;
      font-size: 0.95rem;
      color: #0F172A;
      margin-bottom: 0.25rem;
    }
    .prohibited-item p {
      font-size: 0.85rem;
      line-height: 1.5;
      color: #64748B;
      margin: 0;
    }

    /* Contact Card */
    .legal-contact-card {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 18px;
      padding: 1.75rem;
      margin-top: 1.5rem;
    }
    .contact-card-header {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.25rem;
    }
    .contact-card-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: #ECFDF5;
      color: var(--primary-emerald);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .contact-card-icon i {
      width: 20px;
      height: 20px;
    }
    .contact-card-title {
      font-size: 1.1rem;
      font-weight: 800;
      color: #0F172A;
      margin: 0;
    }
    .contact-card-desc {
      font-size: 0.875rem;
      color: #64748B;
      margin: 0.2rem 0 0 0;
    }
    .contact-card-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .contact-grid-item {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .item-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94A3B8;
      font-weight: 700;
    }
    .item-value {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0F172A;
      text-decoration: none;
    }
    a.item-value:hover {
      color: var(--primary-emerald);
    }

    /* Document Footer Bar */
    .document-footer-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 0.5rem 0 0.5rem;
      color: #94A3B8;
      font-size: 0.875rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .btn-back-to-top {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 100px;
      padding: 0.5rem 1.25rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .btn-back-to-top:hover {
      background: #F1F5F9;
      color: var(--primary-emerald);
      transform: translateY(-2px);
    }
    .btn-back-to-top i {
      width: 16px;
      height: 16px;
    }

    /* Toast Notification for Link Copy */
    .link-copy-toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #0F172A;
      color: white;
      padding: 0.75rem 1.25rem;
      border-radius: 12px;
      font-size: 0.875rem;
      font-weight: 600;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      z-index: 1000;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.3s ease;
      pointer-events: none;
    }
    .link-copy-toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive Media Queries */
    @media (max-width: 1024px) {
      .legal-layout {
        grid-template-columns: 1fr;
      }
      .legal-sidebar {
        display: none;
      }
      .mobile-toc-wrapper {
        display: block;
      }
      .summary-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .legal-header {
        padding: 1.75rem 1.25rem;
        border-radius: 20px;
      }
      .legal-title {
        font-size: 1.85rem;
      }
      .legal-subtitle {
        font-size: 0.975rem;
      }
      .legal-meta-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      .meta-actions {
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
      }
      .legal-section {
        padding: 1.75rem 1.25rem;
        border-radius: 20px;
      }
      .content-intro-card {
        padding: 1.5rem 1.25rem;
      }
      .prohibited-grid {
        grid-template-columns: 1fr;
      }
      .contact-card-grid {
        grid-template-columns: 1fr;
      }
      .summary-card {
        padding: 1.5rem 1.25rem;
      }
    }

    /* Print Stylesheet Optimization */
    @media print {
      .header, .footer, .legal-sidebar, .mobile-toc-wrapper, .meta-actions, .btn-back-to-top {
        display: none !important;
      }
      .legal-page-main {
        padding: 0 !important;
        background: #FFFFFF !important;
      }
      .legal-section, .legal-header, .content-intro-card, .summary-card {
        box-shadow: none !important;
        border: 1px solid #CCCCCC !important;
        page-break-inside: avoid;
        margin-bottom: 1.5rem !important;
      }
      body {
        color: #000000 !important;
        background: #FFFFFF !important;
      }
    }
  </style>

  <div id="copyToast" class="link-copy-toast">
    <i data-lucide="check-circle" style="color: #10B981; width: 16px; height: 16px;"></i>
    <span>Link copied to clipboard!</span>
  </div>

  <%- include('../partials/footer') %>

  <!-- Interactive Scripts -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons();

    // Scroll to Top Smooth Function
    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Share / Copy Document Link with Toast
    function copyDocumentLink() {
      const url = window.location.href;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          showToast();
        }).catch(() => {
          prompt('Copy this link:', url);
        });
      } else {
        prompt('Copy this link:', url);
      }
    }

    function showToast() {
      const toast = document.getElementById('copyToast');
      if (toast) {
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 2500);
      }
    }

    // Mobile Table of Contents Dropdown Toggle
    const mobileTocTrigger = document.getElementById('mobileTocTrigger');
    const mobileTocMenu = document.getElementById('mobileTocMenu');
    const mobileTocChevron = document.getElementById('mobileTocChevron');

    if (mobileTocTrigger && mobileTocMenu && mobileTocChevron) {
      mobileTocTrigger.addEventListener('click', () => {
        const isExpanded = mobileTocTrigger.getAttribute('aria-expanded') === 'true';
        mobileTocTrigger.setAttribute('aria-expanded', !isExpanded);
        mobileTocMenu.classList.toggle('active');
        mobileTocChevron.classList.toggle('rotate');
      });

      // Auto close on link click
      const mobileLinks = mobileTocMenu.querySelectorAll('.toc-mobile-link');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileTocTrigger.setAttribute('aria-expanded', 'false');
          mobileTocMenu.classList.remove('active');
          mobileTocChevron.classList.remove('rotate');
        });
      });
    }

    // ScrollSpy for Desktop Table of Contents
    const sections = document.querySelectorAll('.legal-section');
    const tocLinks = document.querySelectorAll('.toc-link');

    window.addEventListener('scroll', () => {
      let currentSection = '';
      const scrollPos = window.scrollY + 160;

      sections.forEach(section => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.offsetHeight;
        if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
          currentSection = section.getAttribute('id');
        }
      });

      tocLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('data-section') === currentSection) {
          link.classList.add('active');
        }
      });
    });
  </script>
</body>
</html>
