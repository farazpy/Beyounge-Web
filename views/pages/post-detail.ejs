<%- include('../partials/head') %>

<body>
  <%- include('../partials/header') %>

  <main style="padding-top: 100px; padding-bottom: 80px; background-color: #F8FAFC; min-height: 100vh;">
    <div class="container container-narrow">
      
      <div style="margin-bottom: 2rem;">
        <a href="/feed" class="back-btn">
          <i data-lucide="arrow-left" style="width: 18px; height: 18px;"></i>
          <span>Back to Feed</span>
        </a>
      </div>

      <div class="post-detail-card">
        <!-- Post Header -->
        <div class="post-detail-header">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <a href="/<%= post.user.handle.replace('@', '') %>" style="text-decoration: none;">
              <% if (post.user.avatar) { %>
                <img src="<%= post.user.avatar %>" alt="<%= post.user.name %>" class="post-detail-avatar">
              <% } else { %>
                <div class="post-detail-avatar-placeholder">
                  <%= (post.user.name || 'U').charAt(0).toUpperCase() %>
                </div>
              <% } %>
            </a>
            <div>
              <h1 class="post-detail-name">
                <a href="/<%= post.user.handle.replace('@', '') %>" style="color: inherit; text-decoration: none;">
                  <%= post.user.name %>
                </a>
                <% if (post.user.isVerified) { %>
                  <i data-lucide="check-circle-2" class="verified-icon"></i>
                <% } %>
              </h1>
              <p class="post-detail-meta">
                <a href="/<%= post.user.handle.replace('@', '') %>" style="color: inherit; text-decoration: none;">
                  <%= post.user.handle %>
                </a> • <%= post.time %>
              </p>
            </div>
          </div>
          <button class="post-options-btn"><i data-lucide="more-horizontal"></i></button>
        </div>

        <!-- Post Content -->
        <div class="post-detail-body">
          <% if (post.content) { %>
            <p class="post-detail-text"><%= post.content %></p>
          <% } %>
          
          <% if (post.postType === 'reel' && post.videoUrl) { %>
            <div class="post-detail-media reel-media">
              <video src="<%= post.videoUrl %>" controls autoplay playsinline class="reel-video-element"></video>
            </div>
          <% } else if (post.image) { %>
            <div class="post-detail-media image-media">
              <img src="<%= post.image %>" alt="Post Image" class="post-detail-img">
            </div>
          <% } %>

          <% if (post.tags) { %>
            <div class="post-detail-tags">
              <div class="tag-pill">
                <% post.tags.split(',').forEach(tag => { %>
                  <span>#<%= tag.trim() %></span>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Post Actions -->
        <div class="post-detail-actions">
          <button class="detail-action-btn">
            <i data-lucide="heart"></i> <span><%= post.likes %></span>
          </button>
          <button class="detail-action-btn">
            <i data-lucide="message-circle"></i> <span><%= post.comments %></span>
          </button>
          <button class="detail-action-btn share-btn" style="margin-left: auto;">
            <i data-lucide="share-2"></i> <span><%= post.shares %></span>
          </button>
        </div>
      </div>

      <!-- App Promotion Banner -->
      <div class="app-promo-banner">
        <div class="promo-icon-box">
          <i data-lucide="smartphone"></i>
        </div>
        <h3>Join the Conversation</h3>
        <p>Download the Beyounge app to like, comment, and share with your fitness community.</p>
        <a href="https://play.google.com/store/apps/details?id=com.beyounge.app" target="_blank" rel="noopener" class="btn btn-primary promo-btn">
          Download App Now
        </a>
      </div>

    </div>
  </main>

  <style>
    :root {
      --post-card-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      --tag-bg: #E7F9F3;
      --tag-color: #10B981;
    }

    .container-narrow {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 1.2rem;
      background: #EFF6FF;
      color: #1E293B;
      text-decoration: none;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.2s ease;
    }
    .back-btn:hover {
      background: #DBEAFE;
      transform: translateX(-4px);
    }

    .post-detail-card {
      background: #FFFFFF;
      border-radius: 28px;
      padding: 2.5rem;
      border: 1px solid #E2E8F0;
      box-shadow: var(--post-card-shadow);
      margin-bottom: 2rem;
    }

    .post-detail-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
    }

    .post-detail-avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #F1F5F9;
    }

    .post-detail-avatar-placeholder {
      width: 64px;
      height: 64px;
      background: var(--primary-emerald);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1.5rem;
      border-radius: 50%;
    }

    .post-detail-name {
      font-size: 1.25rem;
      font-weight: 800;
      margin: 0;
      color: #0F172A;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .verified-icon {
      width: 18px;
      height: 18px;
      color: var(--primary-emerald);
    }

    .post-detail-meta {
      font-size: 0.95rem;
      color: #64748B;
      margin: 0.25rem 0 0 0;
    }

    .post-options-btn {
      background: none;
      border: none;
      color: #94A3B8;
      cursor: pointer;
      padding: 0.5rem;
      border-radius: 50%;
      transition: background 0.2s;
    }
    .post-options-btn:hover {
      background: #F1F5F9;
      color: #475569;
    }

    .post-detail-body {
      margin-bottom: 2rem;
    }

    .post-detail-text {
      font-size: 1.15rem;
      line-height: 1.7;
      color: #334155;
      margin-bottom: 2rem;
      white-space: pre-wrap;
    }

    .post-detail-media {
      border-radius: 24px;
      overflow: hidden;
      margin-bottom: 2rem;
      background: #F1F5F9;
    }

    .reel-media {
      aspect-ratio: 9/16;
      max-height: 75vh;
      width: auto;
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
      background: #000;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .reel-video-element {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .post-detail-img {
      width: 100%;
      height: auto;
      display: block;
      max-height: 800px;
      object-fit: contain;
    }

    .post-detail-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag-pill {
      background: var(--tag-bg);
      color: var(--tag-color);
      padding: 0.6rem 1.2rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .post-detail-actions {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #F1F5F9;
    }

    .detail-action-btn {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: none;
      border: none;
      color: #64748B;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: color 0.2s ease;
      padding: 0;
    }
    .detail-action-btn:hover {
      color: var(--primary-emerald);
    }
    .detail-action-btn i {
      width: 24px;
      height: 24px;
    }

    .share-btn {
      align-self: flex-end;
    }

    .app-promo-banner {
      text-align: center;
      padding: 3.5rem 2rem;
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 28px;
      box-shadow: var(--post-card-shadow);
    }

    .promo-icon-box {
      width: 64px;
      height: 64px;
      background: #ECFDF5;
      color: var(--primary-emerald);
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem auto;
    }
    .promo-icon-box i {
      width: 32px;
      height: 32px;
    }

    .app-promo-banner h3 {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
      color: #0F172A;
    }

    .app-promo-banner p {
      color: #64748B;
      font-size: 1.05rem;
      line-height: 1.6;
      max-width: 450px;
      margin: 0 auto 2rem auto;
    }

    .promo-btn {
      display: inline-flex;
      justify-content: center;
      width: auto;
      padding: 0.85rem 2.5rem;
      font-weight: 700;
    }

    /* Responsive adjustments */
    @media (max-width: 640px) {
      .post-detail-card {
        padding: 1.5rem;
        border-radius: 20px;
      }
      .post-detail-avatar {
        width: 48px;
        height: 48px;
      }
      .post-detail-avatar-placeholder {
        width: 48px;
        height: 48px;
        font-size: 1.25rem;
      }
      .post-detail-name {
        font-size: 1.1rem;
      }
      .post-detail-text {
        font-size: 1.05rem;
      }
      .tag-pill {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
      }
    }
  </style>

  <%- include('../partials/footer') %>

  <!-- Icons Script -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
