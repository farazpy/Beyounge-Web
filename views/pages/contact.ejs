<%- include('../partials/head') %>
<%- include('../partials/header') %>

<!-- HERO BANNER -->
<section class="section" style="padding-top: 9.5rem; padding-bottom: 3.5rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; align-items: center; margin-bottom: 0.5rem;">
        <span class="badge badge-emerald"><i data-lucide="headphones"></i> Global Support Hub</span>
        <span class="badge badge-cyan" style="font-size: 0.75rem;">🟢 All Systems Operational</span>
        <span class="badge badge-purple" style="font-size: 0.75rem;">⚡ Avg Response: 12 Mins</span>
      </div>
      <h1 class="section-title">We're Here to Help You Succeed</h1>
      <p style="font-size: 1.25rem; max-width: 680px;">
        Have a question about Beyounge AI, need technical assistance, interested in business partnerships, or looking for press assets? Choose a department or drop us a message below.
      </p>
    </div>
  </div>
</section>

<!-- DEPARTMENT CARDS GRID -->
<section class="section" style="padding-top: 0; padding-bottom: 4rem;">
  <div class="container">
    <div class="grid-4">
      <div class="glass-card reveal-on-scroll" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="feature-icon-box" style="width: 48px; height: 48px;"><i data-lucide="wrench"></i></div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Technical Support</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            App sync issues, workout logger questions, camera nutrition tracker bugs, or account recovery.
          </p>
        </div>
        <div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.25rem;">Direct Email</div>
          <a href="mailto:support@beyounge.app" class="gradient-text" style="font-weight: 700; font-size: 0.95rem;">support@beyounge.app</a>
        </div>
      </div>

      <div class="glass-card reveal-on-scroll" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="feature-icon-box feature-icon-purple" style="width: 48px; height: 48px;"><i data-lucide="briefcase"></i></div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Partnerships & Sales</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            Gym chains, fitness creators, corporate wellness programs, and strategic brand integrations.
          </p>
        </div>
        <div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.25rem;">Business Inquiries</div>
          <a href="mailto:partners@beyounge.app" class="gradient-text-purple" style="font-weight: 700; font-size: 0.95rem;">partners@beyounge.app</a>
        </div>
      </div>

      <div class="glass-card reveal-on-scroll" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="feature-icon-box feature-icon-cyan" style="width: 48px; height: 48px;"><i data-lucide="newspaper"></i></div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Press & Media Kit</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            Media inquiries, executive interviews, brand assets, product logos, and official press releases.
          </p>
        </div>
        <div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.25rem;">Media Contact</div>
          <a href="mailto:press@beyounge.app" style="color: var(--accent-cyan); font-weight: 700; font-size: 0.95rem;">press@beyounge.app</a>
        </div>
      </div>

      <div class="glass-card reveal-on-scroll" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="feature-icon-box feature-icon-coral" style="width: 48px; height: 48px;"><i data-lucide="shield-check"></i></div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Privacy & Compliance</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            Data privacy officer, GDPR/CCPA subject requests, and personal health data protection.
          </p>
        </div>
        <div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 0.25rem;">Data Protection Officer</div>
          <a href="mailto:privacy@beyounge.app" style="color: var(--accent-coral); font-weight: 700; font-size: 0.95rem;">privacy@beyounge.app</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MAIN FORM & INTERACTIVE WIDGETS WORKSPACE -->
<section class="section" style="padding-top: 2rem;">
  <div class="container">
    <div class="grid-2" style="align-items: start;">
      
      <!-- Primary Active Contact Form -->
      <div class="glass-card reveal-on-scroll">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem;">
          <div>
            <h3 style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.5rem;">
              <i data-lucide="send" style="color: var(--primary-emerald);"></i>
              <span>Send Support Ticket</span>
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-muted);">Fill in the details and our dedicated support team will get right back to you.</p>
          </div>
          <span class="badge badge-emerald" style="font-size: 0.7rem;">SSL Encrypted</span>
        </div>

        <!-- Success Message Alert Box -->
        <div id="contactSuccessBox" style="display: none; background: rgba(16, 185, 129, 0.12); border: 1px solid var(--primary-emerald); padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <div style="background: var(--primary-emerald); color: #FFFFFF; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; flex-shrink: 0;">✓</div>
            <div>
              <h4 style="color: #047857; margin-bottom: 0.25rem; font-size: 1rem;">Ticket Submitted Successfully!</h4>
              <p style="font-size: 0.875rem; color: var(--text-secondary);" id="contactSuccessText">
                Thank you for reaching out to Beyounge. A member of our fitness tech support team will respond shortly.
              </p>
            </div>
          </div>
        </div>

        <form id="contactForm">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Full Name *</label>
              <input type="text" name="name" id="contactName" required placeholder="Alex Johnson" class="form-input">
            </div>

            <div class="form-group">
              <label class="form-label">Email Address *</label>
              <input type="email" name="email" id="contactEmail" required placeholder="alex@example.com" class="form-input">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Account Type</label>
              <select name="accountType" class="form-select">
                <option value="Free User">Free App User</option>
                <option value="Pro Member">Beyounge Pro Athlete</option>
                <option value="Gym Partner">Gym / Fitness Partner</option>
                <option value="Non-User">Not a user yet</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Inquiry Subject *</label>
              <select name="subject" id="contactSubject" class="form-select">
                <option value="General Support">General Support & App Guidance</option>
                <option value="Bug Report">Technical Bug or App Issue</option>
                <option value="Billing & Pro">Billing & Pro Subscription</option>
                <option value="Feature Request">Feature Request & Idea</option>
                <option value="Business Partnerships">Business & Sponsorship</option>
                <option value="Press & Media">Press & Media Inquiry</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Urgency Level</label>
            <select name="urgency" class="form-select">
              <option value="Normal">Normal Inquiry (12-24 hours)</option>
              <option value="High">High Priority (Within 2-4 hours)</option>
              <option value="Urgent">Urgent Issue (Pro Member Expedited)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Your Message *</label>
            <textarea name="message" id="contactMessage" required placeholder="Describe your issue or request in detail so we can help you fast..." class="form-textarea" style="min-height: 140px;"></textarea>
          </div>

          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); cursor: pointer;">
              <input type="checkbox" required checked style="margin-top: 0.2rem; accent-color: var(--primary-emerald);">
              <span>I consent to Beyounge processing my contact details to resolve my support inquiry according to the <a href="/privacy" style="color: var(--primary-emerald); text-decoration: underline;">Privacy Policy</a>.</span>
            </label>
          </div>

          <button type="submit" id="contactSubmitBtn" class="btn btn-primary btn-glow" style="width: 100%;">
            <i data-lucide="send"></i>
            <span>Submit Support Ticket</span>
          </button>
        </form>
      </div>

      <!-- Right Side Column: Fast Assistance Widgets -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;" class="reveal-on-scroll">
        
        <!-- Live AI Coach Quick Assist Widget -->
        <div class="glass-card" style="border-color: rgba(16, 185, 129, 0.4); background: var(--bg-surface);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
            <span class="badge badge-emerald"><i data-lucide="bot"></i> Instant AI Answers</span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">No Wait Time</span>
          </div>
          <h3 style="font-size: 1.2rem; margin-bottom: 0.35rem;">Need Instant Fitness Advice?</h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 1rem;">
            Have a question about workout splits, nutrition macros, or app features? Try our instant AI Coach right now.
          </p>
          <a href="/#ai-coach-demo" class="btn btn-secondary btn-sm" style="width: 100%;">
            <i data-lucide="sparkles"></i>
            <span>Try Live AI Coach Demo</span>
          </a>
        </div>

        <!-- Phone Callback Scheduler Widget -->
        <div class="glass-card">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <div class="feature-icon-box feature-icon-purple" style="width: 36px; height: 36px; margin: 0; font-size: 1rem;"><i data-lucide="phone-call"></i></div>
            <h3 style="font-size: 1.2rem;">Request a Phone Callback</h3>
          </div>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
            Prefer talking to a specialist? Provide your details and we'll give you a call.
          </p>

          <div id="callbackSuccessBox" style="display: none; background: rgba(124, 58, 237, 0.1); border: 1px solid var(--accent-violet); padding: 0.85rem; border-radius: var(--radius-sm); margin-bottom: 1rem; font-size: 0.85rem; color: #6D28D9;" id="callbackSuccessMsg">
            Callback request received! We will call you at your requested time.
          </div>

          <form id="callbackForm">
            <div class="form-group">
              <input type="text" name="callbackName" required placeholder="Your Name" class="form-input" style="padding: 0.65rem 0.9rem; font-size: 0.9rem;">
            </div>
            <div class="form-group">
              <input type="tel" name="callbackPhone" required placeholder="+1 (555) 000-0000" class="form-input" style="padding: 0.65rem 0.9rem; font-size: 0.9rem;">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;" class="form-group">
              <select name="callbackTime" class="form-select" style="padding: 0.65rem 0.75rem; font-size: 0.85rem;">
                <option value="ASAP (Next 1 hour)">ASAP (Next 1 hr)</option>
                <option value="Morning (9 AM - 12 PM)">Morning (9-12)</option>
                <option value="Afternoon (1 PM - 5 PM)">Afternoon (1-5)</option>
              </select>
              <select name="callbackTopic" class="form-select" style="padding: 0.65rem 0.75rem; font-size: 0.85rem;">
                <option value="General Questions">General Questions</option>
                <option value="Pro Membership">Pro Membership</option>
                <option value="Partnership">Partnerships</option>
              </select>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm" style="width: 100%;">
              <i data-lucide="phone"></i>
              <span>Schedule Call</span>
            </button>
          </form>
        </div>

        <!-- Community & Social Support Channels -->
        <div class="glass-card">
          <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem;">Community Support Channels</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
            Join over 50,000 active athletes in our official community forums for peer tips and live workout discussions.
          </p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="https://discord.gg" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="flex: 1; min-width: 130px;">
              <i data-lucide="message-square"></i> Discord Server
            </a>
            <a href="https://reddit.com" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="flex: 1; min-width: 130px;">
              <i data-lucide="share-2"></i> Reddit Community
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- GLOBAL LOCATIONS & INTERACTIVE MAP SWITCHER -->
<section class="section" style="background: #FFFFFF; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-purple"><i data-lucide="globe"></i> Global Offices</span>
      <h2 class="section-title">Visit Our International Hubs</h2>
      <p>Beyounge operates worldwide with team hubs across North America, Europe, and Asia-Pacific.</p>

      <!-- Location Selector Buttons -->
      <div style="display: inline-flex; gap: 0.5rem; background: rgba(255, 255, 255, 0.95); padding: 0.4rem; border-radius: var(--radius-full); border: 1px solid var(--border-subtle);  margin-top: 1rem;">
        <button class="btn btn-primary btn-sm location-tab-btn active" data-location="sf">
          <i data-lucide="map-pin"></i> San Francisco (Americas HQ)
        </button>
        <button class="btn btn-secondary btn-sm location-tab-btn" data-location="london">
          <i data-lucide="map-pin"></i> London (EMEA Office)
        </button>
        <button class="btn btn-secondary btn-sm location-tab-btn" data-location="singapore">
          <i data-lucide="map-pin"></i> Singapore (APAC Hub)
        </button>
      </div>
    </div>

    <div class="glass-card reveal-on-scroll" style="padding: 1.5rem; overflow: hidden;">
      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: center;">
        
        <!-- Location Details Text -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div class="feature-icon-box" style="width: 40px; height: 40px; margin: 0; flex-shrink: 0;"><i data-lucide="building"></i></div>
            <h3 id="officeTitle" style="font-size: 1.35rem;">Americas HQ - San Francisco, CA</h3>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div>
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Street Address</div>
              <div id="officeAddress" style="font-weight: 600; color: var(--text-primary);">500 Howard Street, San Francisco, CA 94105, USA</div>
            </div>

            <div>
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Local Operating Hours</div>
              <div id="officeHours" style="font-weight: 600; color: var(--text-primary);">Mon - Fri: 8:00 AM - 6:00 PM PST</div>
            </div>

            <div>
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Visitor Policy</div>
              <div style="font-size: 0.875rem; color: var(--text-secondary);">Visitor appointments must be scheduled at least 24 hours in advance via email.</div>
            </div>
          </div>

          <a href="https://maps.google.com/?q=500+Howard+Street+San+Francisco+CA" id="officeDirLink" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="align-self: flex-start; margin-top: 0.5rem;">
            <i data-lucide="navigation"></i>
            <span>Open in Google Maps</span>
            <i data-lucide="external-link" style="width: 14px;"></i>
          </a>
        </div>

        <!-- Embedded Interactive Map Frame -->
        <div style="width: 100%; height: 340px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-subtle); ">
          <iframe 
            id="officeMapIframe"
            title="Beyounge Office Location Map"
            width="100%" 
            height="100%" 
            frameborder="0" 
            scrolling="no" 
            marginheight="0" 
            marginwidth="0" 
            src="https://maps.google.com/maps?q=500%20Howard%20Street%20San%20Francisco%20CA%2094105&t=&z=15&ie=UTF8&iwloc=&output=embed"
            style="filter: contrast(1.05) saturate(1.1); border: 0;"
            allowfullscreen=""
            loading="lazy">
          </iframe>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- RESPONSE TIMES & SLA MATRIX -->
<section class="section">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-cyan"><i data-lucide="clock"></i> SLA Commitments</span>
      <h2 class="section-title">Support Response Time SLA</h2>
      <p>We pride ourselves on lightning-fast technical assistance for all our users worldwide.</p>
    </div>

    <div class="grid-3">
      <div class="glass-card reveal-on-scroll">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <span class="badge badge-emerald">Beyounge Pro</span>
          <span style="font-weight: 800; font-size: 1.5rem; color: #047857;">&lt; 15 Mins</span>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Expedited Priority Queue</h3>
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          Pro subscribers receive expedited ticket processing 24/7/365 with direct access to senior exercise tech specialists.
        </p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <span class="badge badge-purple">Free App Users</span>
          <span style="font-weight: 800; font-size: 1.5rem; color: #7C3AED;">&lt; 2 Hours</span>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Standard Support Queue</h3>
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          All registered users receive fast, human response from our support team to resolve questions or app bugs.
        </p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <span class="badge badge-cyan">Partners & Gyms</span>
          <span style="font-weight: 800; font-size: 1.5rem; color: #0891B2;">&lt; 1 Hour</span>
        </div>
        <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Dedicated Account Manager</h3>
        <p style="font-size: 0.9rem; color: var(--text-muted);">
          Commercial gym partners and enterprise wellness clients get a direct phone line and dedicated account representative.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FREQUENTLY ASKED CONTACT QUESTIONS -->
<section class="section" style="padding-top: 1rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-purple">Quick Clarifications</span>
      <h2 class="section-title">Contact FAQs</h2>
      <p>Common questions regarding reaching out to our team.</p>
    </div>

    <div class="faq-list">
      <div class="faq-item active">
        <button class="faq-question">
          <span>What is the fastest way to get support for my account?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p>The fastest way is submitting a ticket using the contact form above or using the in-app "Help & Support" menu in the Beyounge Android app. Pro members are automatically routed to our expedited queue with average response times under 15 minutes.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          <span>How do I submit a feature request or exercise suggestion?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p>We love user feedback! Select "Feature Request & Idea" in the contact subject dropdown above or share your idea directly in our Discord community feature channel. Our product roadmap is heavily influenced by community votes.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          <span>Where can media outlets download Beyounge press kits and assets?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p>Media representatives can visit our dedicated <a href="/press-kit" style="color: var(--primary-emerald); text-decoration: underline;">Press Kit Page</a> or email <a href="mailto:press@beyounge.app" style="color: var(--primary-emerald); text-decoration: underline;">press@beyounge.app</a> for high-resolution logos, product screenshots, founder headshots, and media releases.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question">
          <span>How can I request personal data removal or account deletion?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p>You can manage data privacy directly inside the app under Settings > Privacy & Data, or visit our dedicated <a href="/data-deletion" style="color: var(--primary-emerald); text-decoration: underline;">Data Deletion Request Page</a> to initiate full account and fitness data erasure.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BOTTOM CTA -->
<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
