<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section" style="padding-top: 9rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-emerald"><i data-lucide="target"></i> Tailored Experience</span>
      <h1 class="section-title">Designed for Your Specific Life & Goals</h1>
      <p style="font-size: 1.25rem;">
        Whether you're stepping into the gym for the first time or preparing for a powerlifting competition, Beyounge adapts to your exact profile.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom: 4rem;">
      <div class="glass-card reveal-on-scroll">
        <div class="feature-icon-box"><i data-lucide="sparkles"></i></div>
        <h3>Beginners</h3>
        <p>Zero gym intimidation. Step-by-step 3D movement visualizers, automatic starting weight recommendations, and friendly AI feedback.</p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div class="feature-icon-box feature-icon-purple"><i data-lucide="clock"></i></div>
        <h3>Busy Professionals</h3>
        <p>Time-restricted 20-30 minute high-yield routines. Quick camera photo meal tracking that takes less than 5 seconds per meal.</p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div class="feature-icon-box feature-icon-cyan"><i data-lucide="flame"></i></div>
        <h3>Weight Loss Seekers</h3>
        <p>Dynamic calorie deficit calculation based on daily steps and activity. High-volume, low-calorie density meal suggestions.</p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div class="feature-icon-box feature-icon-coral"><i data-lucide="biceps"></i></div>
        <h3>Muscle & Strength Builders</h3>
        <p>Scientific progressive overload algorithms keeping your working sets at 1-3 Reps in Reserve (RIR) to maximize hypertrophy.</p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div class="feature-icon-box"><i data-lucide="heart"></i></div>
        <h3>Women’s Fitness</h3>
        <p>Cycle-aware recovery suggestions, pelvic floor and posture workouts, and personalized body recomposition macro splits.</p>
      </div>

      <div class="glass-card reveal-on-scroll">
        <div class="feature-icon-box feature-icon-purple"><i data-lucide="home"></i></div>
        <h3>Home Gym & Bodyweight</h3>
        <p>Algorithms that generate elite workouts using only dumbbells, resistance bands, or zero-equipment bodyweight setups.</p>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
