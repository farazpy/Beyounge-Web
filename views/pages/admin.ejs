<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="<%= description %>" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --wp-admin-bar: #ffffff;
      --wp-sidebar: #ffffff;
      --wp-sidebar-hover: #f1f5f9;
      --wp-blue: #0f172a;
      --wp-blue-hover: #1e293b;
      --wp-blue-light: #3b82f6;
      --wp-canvas: #f8fafc;
      --wp-surface: #ffffff;
      --wp-border: #e2e8f0;
      --wp-border-subtle: #f1f5f9;
      --wp-text: #0f172a;
      --wp-text-muted: #64748b;
      --wp-green: #10b981;
      --wp-amber: #f59e0b;
      --wp-red: #ef4444;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-sans: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    a, button, select, label, input[type="submit"], input[type="button"], input[type="checkbox"], input[type="radio"], [onclick], [role="button"], .wp-btn, .wp-menu-item, .wp-submenu-item, .user-filter-btn, .post-filter-btn, .pin-digit-btn {
      cursor: pointer !important;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--wp-canvas);
      color: var(--wp-text);
      margin: 0;
      padding: 0;
      font-size: 13px;
      line-height: 1.45;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .font-display {
      font-family: var(--font-display);
    }

    .font-mono-num {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
    }

    /* Refined Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Sidebar Navigation Links */
    .wp-menu-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 8px 12px;
      margin: 2px 0;
      color: #475569;
      font-size: 13px;
      font-weight: 500;
      border-radius: 8px;
      transition: all 0.15s ease;
      text-align: left;
      cursor: pointer;
      text-decoration: none;
    }
    .wp-menu-item:hover {
      background-color: #f1f5f9;
      color: #0f172a;
    }
    .wp-menu-item.active {
      background-color: #ecfdf5;
      color: #047857;
      font-weight: 600;
      box-shadow: inset 3px 0 0 0 #10b981;
    }

    .wp-submenu-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 6px 12px 6px 36px;
      margin: 1px 0;
      color: #64748b;
      font-size: 12px;
      background-color: transparent;
      border-radius: 6px;
      transition: all 0.15s ease;
      text-align: left;
      cursor: pointer;
      text-decoration: none;
    }
    .wp-submenu-item:hover {
      color: #0f172a;
      background-color: #f8fafc;
    }
    .wp-submenu-item.active {
      color: #047857;
      font-weight: 600;
      background-color: #ecfdf5;
    }

    /* Premium Data List Table */
    .wp-list-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      background: #ffffff;
    }
    .wp-list-table thead th,
    .wp-list-table tfoot th {
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      border-top: 1px solid #e2e8f0;
      color: #64748b;
      font-weight: 600;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 10px 14px;
      text-align: left;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 5;
    }
    .wp-list-table tbody tr {
      border-bottom: 1px solid #f1f5f9;
      transition: background-color 0.12s ease;
    }
    .wp-list-table tbody tr:nth-child(odd) {
      background-color: #ffffff;
    }
    .wp-list-table tbody tr:nth-child(even) {
      background-color: #f8fafc/50;
    }
    .wp-list-table tbody tr:hover {
      background-color: #ecfdf5/40;
    }
    .wp-list-table td {
      padding: 10px 14px;
      vertical-align: top;
      color: #334155;
      font-size: 12.5px;
      border-bottom: 1px solid #f1f5f9;
    }

    /* Table Row Actions */
    .wp-row-actions {
      font-size: 11.5px;
      color: #94a3b8;
      margin-top: 4px;
      visibility: hidden;
      line-height: 1.4;
    }
    .wp-list-table tbody tr:hover .wp-row-actions,
    .wp-row-actions.always-visible {
      visibility: visible;
    }
    .wp-row-actions button,
    .wp-row-actions a {
      color: #047857;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-size: 11.5px;
      font-weight: 500;
      text-decoration: none;
    }
    .wp-row-actions button:hover,
    .wp-row-actions a:hover {
      color: #065f46;
      text-decoration: underline;
    }
    .wp-row-actions .submitdelete {
      color: #e11d48;
    }
    .wp-row-actions .submitdelete:hover {
      color: #be123c;
    }

    /* Premium Button Components */
    .wp-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      line-height: 1.5;
      min-height: 32px;
      padding: 0 12px;
      cursor: pointer;
      border-width: 1px;
      border-style: solid;
      border-radius: 8px;
      white-space: nowrap;
      font-weight: 600;
      transition: all 0.15s ease;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
    }
    .wp-btn-primary {
      background: #0f172a;
      border-color: #0f172a;
      color: #ffffff;
    }
    .wp-btn-primary:hover {
      background: #1e293b;
      border-color: #1e293b;
      color: #ffffff;
    }
    .wp-btn-secondary {
      background: #ffffff;
      border-color: #e2e8f0;
      color: #334155;
    }
    .wp-btn-secondary:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
      color: #0f172a;
    }
    .wp-btn-danger {
      background: #fff1f2;
      border-color: #fecdd3;
      color: #be123c;
    }
    .wp-btn-danger:hover {
      background: #e11d48;
      border-color: #e11d48;
      color: #ffffff;
    }

    /* Postbox Panels */
    .wp-postbox {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
      margin-bottom: 20px;
      overflow: hidden;
    }
    .wp-postbox-header {
      padding: 12px 16px;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
      font-size: 13.5px;
      color: #0f172a;
      background: #f8fafc/80;
    }
    .wp-postbox-inside {
      padding: 16px;
    }

    /* Form Controls */
    .wp-input, .wp-select, .wp-textarea {
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 12.5px;
      color: #0f172a;
      background-color: #ffffff;
      line-height: 1.5;
      transition: all 0.15s ease;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
    }
    /* ===================================================================== */
    /* AMOLED PURE BLACK DARK MODE STYLES */
    /* ===================================================================== */
    html.amoled-dark {
      --wp-admin-bar: #000000;
      --wp-sidebar: #000000;
      --wp-sidebar-hover: #18181b;
      --wp-canvas: #000000;
      --wp-surface: #000000;
      --wp-border: #27272a;
      --wp-border-subtle: #18181b;
      --wp-text: #ffffff;
      --wp-text-muted: #a1a1aa;
      color-scheme: dark;
    }

    html.amoled-dark,
    html.amoled-dark body,
    html.amoled-dark #adminConsoleShell,
    html.amoled-dark main {
      background-color: #000000 !important;
      color: #ffffff !important;
    }

    html.amoled-dark #wpadminbar,
    html.amoled-dark aside#adminmenuwrap {
      background-color: #000000 !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }

    html.amoled-dark .wp-postbox,
    html.amoled-dark .wp-list-table,
    html.amoled-dark #pinGateOverlay > div,
    html.amoled-dark #wpEditorModal > div,
    html.amoled-dark .bg-white {
      background-color: #000000 !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }

    html.amoled-dark .wp-postbox-header {
      background-color: #0a0a0a !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }

    html.amoled-dark .wp-list-table {
      background-color: #000000 !important;
      color: #ffffff !important;
    }

    html.amoled-dark .wp-list-table thead th,
    html.amoled-dark .wp-list-table tfoot th,
    html.amoled-dark .wp-list-table th,
    html.amoled-dark .wp-list-table th * {
      background-color: #0a0a0a !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }

    html.amoled-dark .wp-list-table tbody tr {
      background-color: #000000 !important;
      border-color: #1f1f23 !important;
      color: #ffffff !important;
    }
    html.amoled-dark .wp-list-table tbody tr:nth-child(even) {
      background-color: #050505 !important;
    }
    html.amoled-dark .wp-list-table tbody tr:hover {
      background-color: #18181b !important;
    }

    /* All table cells, data text, IDs, and column values must be pure crisp white */
    html.amoled-dark .wp-list-table td,
    html.amoled-dark .wp-list-table td * {
      color: #ffffff !important;
    }

    /* Preserve distinct colored action triggers & badges */
    html.amoled-dark .wp-list-table td .submitdelete,
    html.amoled-dark .wp-list-table td button.submitdelete,
    html.amoled-dark .submitdelete,
    html.amoled-dark .text-rose-500,
    html.amoled-dark .text-rose-600,
    html.amoled-dark .text-rose-700,
    html.amoled-dark button.text-rose-600 {
      color: #f87171 !important;
    }
    html.amoled-dark .text-emerald-500,
    html.amoled-dark .text-emerald-600,
    html.amoled-dark .text-emerald-700,
    html.amoled-dark .text-emerald-800,
    html.amoled-dark button.text-emerald-700,
    html.amoled-dark a.text-emerald-700 {
      color: #34d399 !important;
    }
    html.amoled-dark .text-sky-500,
    html.amoled-dark .text-sky-600,
    html.amoled-dark .text-sky-700,
    html.amoled-dark .wp-row-actions a {
      color: #38bdf8 !important;
    }
    html.amoled-dark .text-amber-500,
    html.amoled-dark .text-amber-600,
    html.amoled-dark .text-amber-700 {
      color: #fbbf24 !important;
    }

    html.amoled-dark .group:hover .group-hover\:text-emerald-700 {
      color: #34d399 !important;
    }

    /* Badge backgrounds & contrast in dark mode */
    html.amoled-dark .bg-emerald-100 {
      background-color: #064e3b !important;
      color: #34d399 !important;
      border-color: #059669 !important;
    }
    html.amoled-dark .bg-sky-100 {
      background-color: #0c4a6e !important;
      color: #38bdf8 !important;
      border-color: #0284c7 !important;
    }
    html.amoled-dark .bg-amber-100 {
      background-color: #78350f !important;
      color: #fbbf24 !important;
      border-color: #b45309 !important;
    }
    html.amoled-dark .bg-rose-100 {
      background-color: #881337 !important;
      color: #f87171 !important;
      border-color: #e11d48 !important;
    }

    html.amoled-dark .wp-menu-item {
      color: #ffffff !important;
    }
    html.amoled-dark .wp-menu-item:hover {
      background-color: #18181b !important;
      color: #ffffff !important;
    }
    html.amoled-dark .wp-menu-item.active {
      background-color: #022c22 !important;
      color: #34d399 !important;
      box-shadow: inset 3px 0 0 0 #10b981 !important;
    }

    html.amoled-dark .wp-submenu-item {
      color: #ffffff !important;
    }
    html.amoled-dark .wp-submenu-item:hover {
      background-color: #18181b !important;
      color: #ffffff !important;
    }
    html.amoled-dark .wp-submenu-item.active {
      background-color: #022c22 !important;
      color: #34d399 !important;
    }

    html.amoled-dark select,
    html.amoled-dark input,
    html.amoled-dark textarea,
    html.amoled-dark option,
    html.amoled-dark .wp-input,
    html.amoled-dark .wp-select,
    html.amoled-dark .wp-textarea,
    html.amoled-dark #globalSearchInput,
    html.amoled-dark #quickJumpTableSelect,
    html.amoled-dark select#explorerTableSelect {
      background-color: #0a0a0a !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }
    html.amoled-dark .wp-input:focus,
    html.amoled-dark .wp-select:focus,
    html.amoled-dark .wp-textarea:focus,
    html.amoled-dark #globalSearchInput:focus {
      border-color: #10b981 !important;
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3) !important;
    }

    html.amoled-dark .wp-btn-secondary {
      background-color: #18181b !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }
    html.amoled-dark .wp-btn-secondary:hover {
      background-color: #27272a !important;
      color: #ffffff !important;
    }

    /* Universal pure white overrides for all text utility classes and typography in AMOLED dark mode */
    html.amoled-dark .text-slate-900,
    html.amoled-dark .text-slate-800,
    html.amoled-dark .text-slate-700,
    html.amoled-dark .text-slate-600,
    html.amoled-dark .text-slate-500,
    html.amoled-dark .text-slate-400,
    html.amoled-dark .text-slate-300,
    html.amoled-dark .font-mono-num {
      color: #ffffff !important;
    }

    html.amoled-dark p,
    html.amoled-dark label,
    html.amoled-dark strong,
    html.amoled-dark b,
    html.amoled-dark h1,
    html.amoled-dark h2,
    html.amoled-dark h3,
    html.amoled-dark h4,
    html.amoled-dark th,
    html.amoled-dark td,
    html.amoled-dark code,
    html.amoled-dark span:not([class*="emerald"]):not([class*="rose"]):not([class*="sky"]):not([class*="amber"]):not([class*="badge"]),
    html.amoled-dark #explorerMetaSummary,
    html.amoled-dark #explorerMetaSummary * {
      color: #ffffff !important;
    }

    /* All slate background variations turn to deep AMOLED black */
    html.amoled-dark [class*="bg-slate-50"],
    html.amoled-dark [class*="bg-slate-100"],
    html.amoled-dark [class*="bg-slate-200"],
    html.amoled-dark [class*="bg-slate-300"],
    html.amoled-dark .bg-slate-50,
    html.amoled-dark .bg-slate-100,
    html.amoled-dark .bg-slate-200 {
      background-color: #050505 !important;
      color: #ffffff !important;
    }

    html.amoled-dark [class*="border-slate-"],
    html.amoled-dark .border-slate-100,
    html.amoled-dark .border-slate-200 {
      border-color: #27272a !important;
    }

    html.amoled-dark [class*="hover:bg-slate-"]:hover,
    html.amoled-dark [class*="hover:bg-emerald-"]:hover {
      background-color: #18181b !important;
    }

    html.amoled-dark [class*="hover:border-slate-"]:hover,
    html.amoled-dark [class*="hover:border-emerald-"]:hover {
      border-color: #3f3f46 !important;
    }

    /* 54-Table Schema Cards in AMOLED Dark Mode */
    html.amoled-dark .schema-table-card {
      background-color: #050505 !important;
      border: 1px solid #27272a !important;
    }
    html.amoled-dark .schema-table-card:hover {
      background-color: #0d0d0d !important;
      border-color: #3f3f46 !important;
    }
    html.amoled-dark .schema-table-title,
    html.amoled-dark .schema-table-card .schema-table-title {
      color: #ffffff !important;
    }
    html.amoled-dark .schema-table-card:hover .schema-table-title {
      color: #34d399 !important;
    }
    html.amoled-dark .schema-table-badge,
    html.amoled-dark .schema-table-card .schema-table-badge {
      background-color: #18181b !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }
    html.amoled-dark .schema-table-meta,
    html.amoled-dark .schema-table-card .schema-table-meta {
      color: #a1a1aa !important;
    }
    html.amoled-dark .schema-table-footer,
    html.amoled-dark .schema-table-card .schema-table-footer {
      border-color: #1f1f23 !important;
    }
    html.amoled-dark .schema-table-link,
    html.amoled-dark .schema-table-card .schema-table-link {
      color: #34d399 !important;
    }
    html.amoled-dark .schema-table-link:hover {
      color: #6ee7b7 !important;
    }
    html.amoled-dark .schema-table-addbtn,
    html.amoled-dark .schema-table-card .schema-table-addbtn {
      color: #ffffff !important;
    }
    html.amoled-dark .schema-table-addbtn:hover {
      color: #cbd5e1 !important;
    }

    /* Top KPI Grid buttons */
    html.amoled-dark #overviewKpiGrid > button {
      background-color: #050505 !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }
    html.amoled-dark #overviewKpiGrid > button:hover {
      background-color: #0d0d0d !important;
      border-color: #3f3f46 !important;
    }

    /* At a Glance & Coach boxes */
    html.amoled-dark #overviewAtAGlanceBox > div > div,
    html.amoled-dark #overviewCoachAppsBox > div {
      background-color: #050505 !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }
    html.amoled-dark #overviewCoachAppsBox .border-t {
      border-color: #1f1f23 !important;
    }

    /* Sidebar quick list */
    html.amoled-dark #sidebarAllTablesList {
      background-color: #050505 !important;
      border-color: #27272a !important;
    }
    html.amoled-dark #sidebarAllTablesList > a {
      color: #ffffff !important;
    }
    html.amoled-dark #sidebarAllTablesList > a:hover {
      background-color: #18181b !important;
      color: #34d399 !important;
    }

    html.amoled-dark #adminThemeToggleBtn {
      background-color: #0a0a0a !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }

    html.amoled-dark .post-filter-btn,
    html.amoled-dark .user-filter-btn {
      color: #ffffff !important;
    }
    html.amoled-dark .post-filter-btn.bg-slate-200\/60,
    html.amoled-dark .user-filter-btn.bg-slate-200\/60 {
      background-color: #27272a !important;
      color: #ffffff !important;
    }

    html.amoled-dark .pin-digit-btn {
      background-color: #09090b !important;
      border-color: #27272a !important;
      color: #ffffff !important;
    }
    html.amoled-dark .pin-digit-btn:hover {
      background-color: #18181b !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900">

  <!-- ===================================================================== -->
  <!-- 1. PIN 9292 AUTHENTICATION GATE                                       -->
  <!-- ===================================================================== -->
  <div id="pinGateOverlay" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white border border-slate-200 shadow-2xl rounded-2xl p-7">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-slate-900 text-white flex items-center justify-center font-display font-bold text-xl rounded-xl shadow-xs">
            B
          </div>
          <div>
            <h1 class="text-base font-bold text-slate-900 leading-tight">Beyounge Admin</h1>
            <p class="text-xs text-slate-500">54-Table Shared Database Console</p>
          </div>
        </div>
        <span class="font-mono-num text-xs bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-semibold border border-emerald-200">v1.2.9</span>
      </div>

      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        Enter the 4-digit Security PIN to unlock full read/write CRUD access across all 54 MySQL tables.
      </p>

      <form id="pinForm" class="space-y-4" onsubmit="return false;">
        <div>
          <label for="pinInput" class="block text-xs font-semibold text-slate-900 mb-1.5">Security PIN</label>
          <input
            id="pinInput"
            type="password"
            inputmode="numeric"
            maxlength="4"
            autocomplete="off"
            placeholder="••••"
