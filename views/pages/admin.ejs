    // =====================================================================
    // CONSOLIDATED BULK ACTIONS & ANDROID MODERATION
    // =====================================================================
    async function applyBulkAction(tableName, checkboxClass, selectId) {
      const action = document.getElementById(selectId).value;
      if (!action) return;

      const selectedCbs = Array.from(document.querySelectorAll(`.${checkboxClass}:checked`));
      if (selectedCbs.length === 0) {
        showNotice('Select at least one row first.', true);
        return;
      }

      const rows = selectedCbs.map(cb => decodeRowData(cb.dataset.row));

      if (action === 'export_csv') {
        exportRowsToCsv(`${tableName}_selected.csv`, rows);
        return;
      }

      if (action === 'delete') {
        if (!confirm(`Are you sure you want to PERMANENTLY delete ${rows.length} records from ${tableName}? This cannot be undone.`)) return;

        const whereKeys = rows.map(r => extractWhereKey(tableName, r));
        try {
          const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/bulk`, {
            method: 'POST',
            body: JSON.stringify({ action: 'delete', whereKeys })
          });
          showNotice(res.message);
          await loadDashboardData(true);
          if (activeTab === 'explorer') await loadExplorerTable(explorerState.tableName, explorerState.offset);
        } catch (err) {
          showNotice(`Bulk delete failed: ${err.message}`, true);
        }
      } else if (action.startsWith('status_')) {
        const newStatus = action.replace('status_', '');
        const whereKeys = rows.map(r => extractWhereKey(tableName, r));
        try {
          const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/bulk`, {
            method: 'POST',
            body: JSON.stringify({ action: 'update', whereKeys, updateData: { status: newStatus } })
          });
          showNotice(res.message);
          await loadDashboardData(true);
        } catch (err) {
          showNotice(`Bulk update failed: ${err.message}`, true);
        }
      } else {
        let updateData = {};
        if (action === 'verify') updateData = { is_verified: 1 };
        else if (action === 'unverify') updateData = { is_verified: 0 };
        else if (action === 'onboard') updateData = { isOnboarded: 1 };
        else if (action === 'make_admin') updateData = { isAdmin: 1, role: 'admin' };
        else if (action === 'revoke_admin') updateData = { isAdmin: 0, role: 'user' };
        else if (action === 'set_reel') updateData = { postType: 'reel' };
        else if (action === 'set_image') updateData = { postType: 'image' };
        else if (action === 'set_text') updateData = { postType: 'text' };

        if (Object.keys(updateData).length === 0) return;

        const whereKeys = rows.map(r => extractWhereKey(tableName, r));
        try {
          const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/bulk`, {
            method: 'POST',
            body: JSON.stringify({ action: 'update', whereKeys, updateData })
          });
          showNotice(res.message);
          await loadDashboardData(true);
        } catch (err) {
          showNotice(`Bulk update failed: ${err.message}`, true);
        }
      }
    }

    function applyUsersBulkAction() { applyBulkAction('users', 'user-row-cb', 'usersBulkActionSelect'); }
    function applyPostsBulkAction() { applyBulkAction('posts', 'post-row-cb', 'postsBulkActionSelect'); }
    function applyExplorerBulkAction() { applyBulkAction(explorerState.tableName, 'explorer-row-cb', 'explorerBulkActionSelect'); }

