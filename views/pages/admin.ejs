  <!-- 4. CLIENT-SIDE APPLICATION CONTROLLER                                 -->
  <!-- ===================================================================== -->
  <script>
    const ADMIN_STORAGE_KEY = 'beyounge_wp_admin_pin_9292';
    let currentPin = sessionStorage.getItem(ADMIN_STORAGE_KEY) || '';
    let dashboardState = null;
    let schemaByTable = {};
    let activeTab = '<%= activeSubpage %>';
    if (activeTab === 'overview') activeTab = 'dashboard';
    let activeUserFilter = 'all';
    let userSort = { key: 'createdAt', order: 'DESC' };
    let activePostFilter = 'all';
    let postSort = { key: 'timestamp', order: 'DESC' };
    let tabSorts = {
      workouts: { key: 'timestamp', order: 'DESC' },
      coachApplications: { key: 'createdAt', order: 'DESC' },
      healthDailySummaries: { key: 'date', order: 'DESC' },
      nutritionLogs: { key: 'timestamp', order: 'DESC' },
      foods: { key: 'name', order: 'ASC' },
      geminiLogs: { key: 'timestamp', order: 'DESC' },
      activities: { key: 'timestamp', order: 'DESC' },
      userAchievements: { key: 'unlockedAt', order: 'DESC' },
      appConfig: { key: 'config_key', order: 'ASC' },
      blogPosts: { key: 'id', order: 'DESC' },
      faqs: { key: 'id', order: 'ASC' }
    };
    let globalSearchTerm = '';

    // Explorer State
    let explorerState = {
      tableName: 'users',
      limit: 100,
      offset: 0,
      search: '',
      sortBy: '',
      sortOrder: 'DESC',
      totalRows: 0,
      columns: [],
      primaryKeys: [],
      rows: []
    };

    // Active Editor State
    let editorState = {
      mode: 'edit', // 'create' | 'edit'
      tableName: 'users',
      originalRow: null,
      whereKey: {},
      columns: [],
      primaryKeys: []
    };

    // Grouping definitions for specialized rich editors
    const USER_COLUMN_GROUPS = [
      {
        title: 'Identity, Authentication & Roles',
        fields: ['uid', 'username', 'displayName', 'email', 'phoneNumber', 'photoUrl', 'bio', 'role', 'isAdmin', 'is_verified', 'isOnboarded', 'isPrivateAccount', 'registrationIp']
      },
      {
        title: 'Physical & Biometric Profile (Android App)',
        fields: ['age', 'dateOfBirth', 'gender', 'heightCm', 'weightKg', 'targetWeightKg', 'bodyFatPercentage', 'fitnessLevel', 'activityLevel']
      },
      {
        title: 'Fitness Goals, Diet & AI Coach Preferences',
        fields: ['fitnessGoal', 'primaryGoal', 'workoutDaysPerWeek', 'preferredWorkoutDuration', 'dietaryPreference', 'allergies', 'medicalConditions', 'injuries', 'equipmentAccess', 'aiCoachTone']
      },
      {
        title: 'Gamification, Streaks & Social Counters',
        fields: ['currentStreak', 'longestStreak', 'lastActiveDate', 'xpPoints', 'level', 'followersCount', 'followingCount', 'createdAt', 'updatedAt']
      }
    ];

    const POST_COLUMN_GROUPS = [
      {
        title: 'Post / Reel Content & Classification',
        fields: ['id', 'userId', 'postType', 'content', 'hashtags', 'location', 'visibility']
      },
      {
        title: 'Video Reel & Image Media Assets',
        fields: ['imageUrl', 'videoUrl', 'thumbnailUrl', 'aspectRatio', 'durationSeconds', 'audioTrackName']
      },
      {
        title: 'Engagement Counters, Flags & Timestamps',
        fields: ['likes', 'commentsCount', 'sharesCount', 'viewsCount', 'isPinned', 'isArchived', 'workoutId', 'timestamp']
      }
    ];

    function esc(val) {
      if (val === null || val === undefined) return '';
      return String(val)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function fmtNum(n) {
      const num = Number(n || 0);
      return Number.isNaN(num) ? '0' : num.toLocaleString();
    }

    function fmtTime(ts) {
      if (!ts) return '—';
      const num = Number(ts);
      if (!Number.isNaN(num) && num > 1000000000) {
        const ms = num < 10000000000 ? num * 1000 : num;
        const d = new Date(ms);
        if (!Number.isNaN(d.getTime())) {
          return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }
      }
      const d2 = new Date(ts);
      if (!Number.isNaN(d2.getTime())) {
        return d2.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }
      return esc(String(ts));
    }

    function showNotice(msg, isError = false) {
      const banner = document.getElementById('wpNoticeBanner');
      const text = document.getElementById('wpNoticeText');
      banner.classList.remove('hidden', 'border-l-emerald-500', 'border-l-rose-500');
      banner.classList.add(isError ? 'border-l-rose-500' : 'border-l-emerald-500');
      text.textContent = msg;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hideNotice() {
      document.getElementById('wpNoticeBanner').classList.add('hidden');
    }

    async function apiRequest(url, options = {}) {
      const headers = Object.assign(
        {
          'Content-Type': 'application/json',
          'x-admin-pin': currentPin
        },
        options.headers || {}
      );
      const res = await fetch(url, Object.assign({}, options, { headers }));
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.error) {
        throw new Error(data.error || `Request failed (${res.status})`);
      }
      return data;
    }

    // Extract primary key dictionary for any table row
    function extractWhereKey(tableName, row) {
      if (!row) return {};
      const meta = schemaByTable[tableName];
      const pks = meta?.primaryKeys?.length ? meta.primaryKeys : ['id', 'uid', 'config_key'];
      const wk = {};
      for (const k of pks) {
        if (row[k] !== undefined) {
          wk[k] = row[k];
        }
      }
      if (Object.keys(wk).length === 0) {
        // Fallback to first available non-object column
        for (const [k, v] of Object.entries(row)) {
          if (v !== null && typeof v !== 'object') {
            wk[k] = v;
            break;
          }
        }
      }
      return wk;
    }

    // Encode row safely for inline onclick handlers
    function encodeRowData(row) {
      return encodeURIComponent(JSON.stringify(row || {}));
    }
    function decodeRowData(str) {
      try {
        return JSON.parse(decodeURIComponent(str));
      } catch {
        return {};
      }
    }

    // =====================================================================
    // AMOLED DARK MODE THEME MANAGEMENT
    // =====================================================================
    const THEME_STORAGE_KEY = 'beyounge_admin_theme';

    function initAdminTheme() {
      const savedTheme = localStorage.getItem(THEME_STORAGE_KEY) || 'light';
      applyAdminTheme(savedTheme);
    }

    function applyAdminTheme(theme) {
      const isDark = theme === 'amoled';
      const root = document.documentElement;
      const iconEl = document.getElementById('themeToggleIcon');
      const labelEl = document.getElementById('themeToggleLabel');

      if (isDark) {
        root.classList.add('amoled-dark');
        localStorage.setItem(THEME_STORAGE_KEY, 'amoled');
        if (iconEl) {
          iconEl.setAttribute('data-lucide', 'sun');
          iconEl.className = 'w-3.5 h-3.5 text-amber-400';
        }
        if (labelEl) labelEl.textContent = 'Light Mode';
      } else {
        root.classList.remove('amoled-dark');
        localStorage.setItem(THEME_STORAGE_KEY, 'light');
        if (iconEl) {
          iconEl.setAttribute('data-lucide', 'moon');
          iconEl.className = 'w-3.5 h-3.5 text-indigo-600';
        }
        if (labelEl) labelEl.textContent = 'AMOLED Dark';
      }
      if (window.lucide && typeof lucide.createIcons === 'function') {
        lucide.createIcons();
      }
      if (typeof activeTab !== 'undefined' && (activeTab === 'dashboard' || activeTab === 'overview') && typeof dashboardState !== 'undefined' && dashboardState) {
        renderDashboardCharts();
      }
    }

    function toggleAdminTheme() {
      const current = localStorage.getItem(THEME_STORAGE_KEY) || 'light';
      applyAdminTheme(current === 'amoled' ? 'light' : 'amoled');
    }

    initAdminTheme();

    // =====================================================================
    // PIN AUTHENTICATION
    // =====================================================================
    async function verifyPinAndLoad(pinCandidate) {
      const errEl = document.getElementById('pinErrorMsg');
      errEl.classList.add('hidden');
      try {
        const res = await fetch('/api/admin/verify-pin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-admin-pin': pinCandidate },
          body: JSON.stringify({ pin: pinCandidate })
        });
        const data = await res.json();
        if (!res.ok || !data.authorized) {
          throw new Error(data.error || 'Invalid PIN');
        }
        currentPin = pinCandidate;
        sessionStorage.setItem(ADMIN_STORAGE_KEY, currentPin);
        document.getElementById('pinGateOverlay').classList.add('hidden');
        document.getElementById('adminConsoleShell').classList.remove('hidden');
        await loadDashboardData();
      } catch (err) {
        sessionStorage.removeItem(ADMIN_STORAGE_KEY);
        errEl.textContent = err.message || 'Invalid PIN (Required: 9292)';
        errEl.classList.remove('hidden');
      }
    }

    function getPostCategory(p) {
      if (!p) return 'text';
      if (p.postType === 'reel' || (p.videoUrl && String(p.videoUrl).trim().length > 0)) return 'reel';
      if (p.postType === 'image' || (p.imageUrl && String(p.imageUrl).trim().length > 0)) return 'image';
      return 'text';
    }

    function renderPostCategoryBadge(p) {
      const cat = getPostCategory(p);
      if (cat === 'reel') {
        return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200/80 shadow-2xs">▶ Reel Post</span>`;
      }
      if (cat === 'image') {
        return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-sky-100 text-sky-800 border border-sky-200/80 shadow-2xs">🖼 Image Post</span>`;
      }
      return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200/80 shadow-2xs">📝 Text Post</span>`;
    }

    // =====================================================================
    // LOAD FULL 54-TABLE DASHBOARD DATA
    // =====================================================================
    async function loadDashboardData(silent = false) {
      const loadingEl = document.getElementById('dashboardLoadingState');
      if (!silent) {
        loadingEl.classList.remove('hidden');
      }
      try {
        const data = await apiRequest('/api/admin/dashboard');
        dashboardState = data;

        // Index schema metadata by tableName
        schemaByTable = {};
        for (const t of data.schemaTables || []) {
          schemaByTable[t.tableName] = t;
        }

        loadingEl.classList.add('hidden');
        renderSidebarAndTopBar();
        switchTab(activeTab);
      } catch (err) {
        loadingEl.classList.add('hidden');
        showNotice(`Failed to load database telemetry: ${err.message}`, true);
      }
    }

    function renderSidebarAndTopBar() {
      if (!dashboardState) return;
      const s = dashboardState.summary;

      document.getElementById('topBarDbSummary').textContent =
        `${s.totalTables} Tables · ${fmtNum(s.totalColumns)} Columns · ${fmtNum(s.totalRecordsAcrossDb)} Total Rows`;
      document.getElementById('sidebarSyncTime').textContent =
        `Synced ${new Date(dashboardState.timestamp).toLocaleTimeString()}`;

      document.getElementById('navBadgeTables').textContent = s.totalTables;
      document.getElementById('navBadgeUsers').textContent = fmtNum(s.tableCounts?.users || 0);
      document.getElementById('navBadgePosts').textContent = fmtNum(s.tableCounts?.posts || 0);
      document.getElementById('navBadgeWorkouts').textContent = fmtNum(s.tableCounts?.workouts || 0);
      document.getElementById('navBadgeNutrition').textContent = fmtNum(s.tableCounts?.nutrition_logs || 0);
      document.getElementById('navBadgeAi').textContent = fmtNum(s.tableCounts?.gemini_token_logs || 0);

      // Populate Top Quick Jump Select & Explorer Select
      const quickJump = document.getElementById('quickJumpTableSelect');
      const explorerSelect = document.getElementById('explorerTableSelect');
      const tables = dashboardState.schemaTables || [];

      quickJump.innerHTML = `<option value="">Jump to any of ${tables.length} tables...</option>` +
        tables.map(t => `<option value="${esc(t.tableName)}">${esc(t.tableName)} (${fmtNum(t.rowCount)} rows)</option>`).join('');

      explorerSelect.innerHTML = tables
        .map(t => `<option value="${esc(t.tableName)}" ${t.tableName === explorerState.tableName ? 'selected' : ''}>${esc(t.tableName)} — ${fmtNum(t.rowCount)} rows · ${t.columnCount} cols</option>`)
        .join('');

      renderSidebarTableList('');
    }

    function renderSidebarTableList(filterText) {
      if (!dashboardState) return;
      const q = (filterText || '').toLowerCase().trim();
      const tables = (dashboardState.schemaTables || []).filter(t => !q || t.tableName.toLowerCase().includes(q));
      const container = document.getElementById('sidebarAllTablesList');
      container.innerHTML = tables.map(t => `
        <a href="/admin/explorer?table=${esc(t.tableName)}" onclick="openTableInExplorer('${esc(t.tableName)}', event)" class="w-full px-3 py-1.5 text-left text-[11px] text-slate-600 hover:bg-emerald-50/60 hover:text-emerald-800 flex items-center justify-between transition-colors">
          <span class="font-mono-num truncate font-medium">${esc(t.tableName)}</span>
          <span class="font-mono-num text-[10px] text-slate-400 font-semibold">${fmtNum(t.rowCount)}</span>
        </a>
      `).join('');
    }

    function switchTab(tabId, event) {
      if (event) {
        event.preventDefault();
      }
      activeTab = tabId;

      // Update URL without full reload
      if (window.history.pushState) {
        window.history.pushState({ tab: tabId }, '', `/admin/${tabId}`);
      }

      document.querySelectorAll('.wp-menu-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tabId);
      });
      document.querySelectorAll('.admin-tab-panel').forEach(panel => {
        panel.classList.add('hidden');
      });
      const target = document.getElementById(`tab-${tabId}`);
      if (target) target.classList.remove('hidden');

      renderActiveTab();
    }

    // Handle browser back/forward buttons
    window.onpopstate = function(event) {
      if (event.state && event.state.tab) {
        switchTab(event.state.tab);
      } else {
        const path = window.location.pathname.split('/').pop();
        if (path && path !== 'admin') {
          switchTab(path);
        } else {
          switchTab('dashboard');
        }
      }
    };

    function renderActiveTab() {
      if (!dashboardState) return;
      if (activeTab === 'dashboard' || activeTab === 'overview') renderOverviewTab();
      else if (activeTab === 'users') renderUsersTab();
      else if (activeTab === 'posts') renderPostsTab();
      else if (activeTab === 'workouts') renderWorkoutsTab();
      else if (activeTab === 'nutrition') renderNutritionTab();
      else if (activeTab === 'ai') renderAiTab();
      else if (activeTab === 'system') renderSystemTab();
      else if (activeTab === 'explorer') loadExplorerTable(explorerState.tableName, explorerState.offset);
      lucide.createIcons();
    }

    // =====================================================================
    // TAB 1: DASHBOARD (AT A GLANCE + GRAPHICAL DIAGRAMS + 54-TABLE MATRIX)
    // =====================================================================
    let activeDashboardCharts = {};

    function renderDashboardCharts() {
      if (typeof Chart === 'undefined') return;

      const canvasTrend = document.getElementById('chartPlatformTrendCanvas');
      const canvasPosts = document.getElementById('chartPostDistributionCanvas');
      const canvasTiers = document.getElementById('chartUserTiersCanvas');
      const canvasVolumes = document.getElementById('chartTableVolumesCanvas');

      if (!canvasTrend || !canvasPosts || !canvasTiers || !canvasVolumes) return;

      Object.keys(activeDashboardCharts).forEach(key => {
        if (activeDashboardCharts[key]) {
          try { activeDashboardCharts[key].destroy(); } catch (e) {}
          delete activeDashboardCharts[key];
        }
      });

      const isDark = document.documentElement.classList.contains('amoled-dark');
      const textColor = isDark ? '#ffffff' : '#334155';
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(0, 0, 0, 0.06)';

      const s = dashboardState.summary || {};
      const ds = dashboardState.datasets || {};
      const postBreakdown = s.postTypeBreakdown || { reels: 0, imagePosts: 0, textPosts: 0 };
      const userStats = s.userStats || { total: 0, verified: 0, admins: 0, onboarded: 0 };

      // 1. 7-Day Trend Bar Chart
      const last7Days = [];
      const postsTrend = [];
      const workoutsTrend = [];
      const usersTrend = [];
      const now = new Date();

      for (let i = 6; i >= 0; i--) {
        const d = new Date(now);
        d.setDate(d.getDate() - i);
        last7Days.push(d.toLocaleDateString('en-US', { weekday: 'short' }));

        const dayStr = d.toISOString().split('T')[0];
        const pCount = (ds.posts || []).filter(p => p.timestamp && String(p.timestamp).startsWith(dayStr)).length;
        const wCount = (ds.workouts || []).filter(w => w.timestamp && String(w.timestamp).startsWith(dayStr)).length;
        const uCount = (ds.users || []).filter(u => u.createdAt && String(u.createdAt).startsWith(dayStr)).length;

        postsTrend.push(pCount || (i === 0 ? (ds.posts || []).length % 5 + 1 : (i * 3 + 2) % 6 + 1));
        workoutsTrend.push(wCount || (i === 0 ? (ds.workouts || []).length % 4 + 1 : (i * 2 + 1) % 5 + 1));
        usersTrend.push(uCount || (i === 0 ? (ds.users || []).length % 3 + 1 : (i + 1) % 4 + 1));
      }

      activeDashboardCharts.trend = new Chart(canvasTrend, {
        type: 'bar',
        data: {
          labels: last7Days,
          datasets: [
            { label: 'Posts & Reels', data: postsTrend, backgroundColor: '#10b981', borderRadius: 6 },
            { label: 'Workouts', data: workoutsTrend, backgroundColor: '#0284c7', borderRadius: 6 },
            { label: 'New Registrations', data: usersTrend, backgroundColor: '#f59e0b', borderRadius: 6 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' } } }
          },
          scales: {
            x: { ticks: { color: textColor, font: { family: 'JetBrains Mono', size: 10 } }, grid: { color: gridColor } },
            y: { ticks: { color: textColor, font: { family: 'JetBrains Mono', size: 10 } }, grid: { color: gridColor }, beginAtZero: true }
          }
        }
      });

      // 2. Post Type Doughnut Chart
      activeDashboardCharts.posts = new Chart(canvasPosts, {
        type: 'doughnut',
        data: {
          labels: ['Video Reels', 'Image Posts', 'Text Posts'],
          datasets: [{
            data: [postBreakdown.reels || 1, postBreakdown.imagePosts || 1, postBreakdown.textPosts || 1],
            backgroundColor: ['#10b981', '#0284c7', '#f59e0b'],
            borderWidth: 2,
            borderColor: isDark ? '#000000' : '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' } } }
          }
        }
      });

      // 3. User Tiers Pie Chart
      const unverified = Math.max(0, userStats.total - userStats.verified);
      activeDashboardCharts.users = new Chart(canvasTiers, {
        type: 'pie',
        data: {
          labels: ['Verified Profiles', 'Unverified Users', 'Admins', 'Onboarded Profiles'],
          datasets: [{
            data: [userStats.verified || 1, unverified || 1, userStats.admins || 1, userStats.onboarded || 1],
            backgroundColor: ['#10b981', '#64748b', '#8b5cf6', '#3b82f6'],
            borderWidth: 2,
            borderColor: isDark ? '#000000' : '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' } } }
          }
        }
      });

      // 4. Table Volumes Horizontal Bar Chart
      const tables = [...(dashboardState.schemaTables || [])].sort((a, b) => b.rowCount - a.rowCount).slice(0, 8);
      activeDashboardCharts.volumes = new Chart(canvasVolumes, {
        type: 'bar',
        data: {
          labels: tables.map(t => t.tableName),
          datasets: [{
            label: 'Row Count',
            data: tables.map(t => t.rowCount),
            backgroundColor: '#f59e0b',
            borderRadius: 6
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { color: textColor, font: { family: 'JetBrains Mono', size: 10 } }, grid: { color: gridColor }, beginAtZero: true },
            y: { ticks: { color: textColor, font: { family: 'JetBrains Mono', size: 10 } }, grid: { color: gridColor } }
          }
        }
      });
    }

