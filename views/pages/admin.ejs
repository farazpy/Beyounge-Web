    // =====================================================================
    // TAB 8: UNIVERSAL 54-TABLE CRUD EXPLORER
    // =====================================================================
    async function openTableInExplorer(tableName, event) {
      if (event) {
        event.preventDefault();
      }
      explorerState.tableName = tableName;
      explorerState.offset = 0;
      explorerState.search = '';
      document.getElementById('explorerSearchInput').value = '';
      const sel = document.getElementById('explorerTableSelect');
      if (sel) sel.value = tableName;
      switchTab('explorer');
    }

    async function loadExplorerTable(tableName, offset = 0) {
      try {
        explorerState.tableName = tableName;
        explorerState.offset = Math.max(0, offset);
        const q = encodeURIComponent(explorerState.search || '');
        const res = await apiRequest(
          `/api/admin/table/${encodeURIComponent(tableName)}?limit=${explorerState.limit}&offset=${explorerState.offset}&search=${q}&sortBy=${explorerState.sortBy}&sortOrder=${explorerState.sortOrder}`
        );

        explorerState.columns = res.columns || [];
        explorerState.primaryKeys = res.primaryKeys || [];
        explorerState.totalRows = res.totalRows || 0;
        explorerState.rows = res.rows || [];

        // Keep schemaByTable synced
        schemaByTable[tableName] = {
          tableName,
          rowCount: res.totalRows,
          columnCount: explorerState.columns.length,
          primaryKeys: explorerState.primaryKeys,
          columns: explorerState.columns.map(c => ({
            columnName: c.Field,
            columnType: c.Type,
            isNullable: c.Null,
            columnKey: c.Key,
            columnDefault: c.Default,
            extra: c.Extra
          }))
        };

        renderExplorerGrid();
      } catch (err) {
        showNotice(`Explorer Error (${tableName}): ${err.message}`, true);
      }
    }

    function renderExplorerGrid() {
      const { tableName, columns, primaryKeys, totalRows, offset, limit, rows } = explorerState;
      document.getElementById('explorerMetaSummary').innerHTML =
        `Table: <strong class="text-slate-900 font-bold">${esc(tableName)}</strong> · <span class="font-bold text-slate-800">${fmtNum(totalRows)}</span> rows · ${columns.length} columns · Primary Key: <strong class="text-slate-900">${esc(primaryKeys.join(', ') || 'auto')}</strong>`;

      const pageNum = Math.floor(offset / limit) + 1;
      const totalPages = Math.max(1, Math.ceil(totalRows / limit));
      document.getElementById('explorerPageInfo').textContent = `Page ${pageNum} of ${totalPages}`;
      document.getElementById('explorerPrevBtn').disabled = offset <= 0;
      document.getElementById('explorerNextBtn').disabled = offset + limit >= totalRows;

      // Render Header
      const colNames = columns.map(c => c.Field);
      document.getElementById('explorerTableHead').innerHTML = `
        <tr>
          <th class="w-8"><input type="checkbox" onchange="toggleSelectAll('explorer-row-cb', this.checked)" /></th>
          <th class="w-36">Row Actions</th>
          ${columns.map(c => {
            const isActiveSort = explorerState.sortBy === c.Field;
            const sortIcon = isActiveSort ? (explorerState.sortOrder === 'ASC' ? '↑' : '↓') : '';
            return `
              <th onclick="toggleExplorerSort('${esc(c.Field)}')" class="cursor-pointer hover:bg-slate-100 group">
                <div class="flex items-center gap-1">
                  <div class="font-mono-num text-xs">${esc(c.Field)} ${c.Key === 'PRI' ? '🔑' : ''}</div>
                  <span class="text-slate-900 font-bold text-xs">${sortIcon}</span>
                </div>
                <div class="font-mono-num text-[10px] font-normal text-slate-400 group-hover:text-slate-700">${esc(c.Type)}</div>
              </th>
            `;
          }).join('')}
        </tr>
      `;

      if (rows.length === 0) {
        document.getElementById('explorerTableBody').innerHTML = `
          <tr>
            <td colspan="${columns.length + 2}" class="p-8 text-center text-xs text-slate-500">
              No records in <strong class="font-mono-num text-slate-900">${esc(tableName)}</strong> matching current query.
              <button type="button" onclick="openRecordEditor('${esc(tableName)}', null)" class="ml-2 text-emerald-700 underline font-semibold">+ Create First Record</button>
            </td>
          </tr>
        `;
        return;
      }

      document.getElementById('explorerTableBody').innerHTML = rows.map(row => {
        const rowEnc = encodeRowData(row);
        return `
          <tr>
            <td>
              <input type="checkbox" class="explorer-row-cb" data-row="${rowEnc}" />
            </td>
            <td class="whitespace-nowrap">
              <button type="button" onclick="openRecordEditorDecoded('${esc(tableName)}', '${rowEnc}')" class="text-xs font-semibold text-slate-800 hover:text-slate-900 hover:underline mr-2">Edit</button>
              <button type="button" onclick="confirmDeleteRow('${esc(tableName)}', '${rowEnc}')" class="text-xs text-rose-600 hover:underline">Delete</button>
            </td>
            ${colNames.map(col => {
              const v = row[col];
              const str = v === null || v === undefined ? 'NULL' : typeof v === 'object' ? JSON.stringify(v) : String(v);
              return `<td class="font-mono-num text-xs max-w-xs truncate" title="${esc(str)}">${v === null || v === undefined ? '<span class="text-slate-400">NULL</span>' : esc(str)}</td>`;
            }).join('')}
          </tr>
        `;
      }).join('');
    }

    function toggleExplorerSort(column) {
      if (explorerState.sortBy === column) {
        explorerState.sortOrder = explorerState.sortOrder === 'ASC' ? 'DESC' : 'ASC';
      } else {
        explorerState.sortBy = column;
        explorerState.sortOrder = 'ASC';
      }
      loadExplorerTable(explorerState.tableName, 0);
    }

    function toggleUserSort(key) {
      if (userSort.key === key) {
        userSort.order = userSort.order === 'ASC' ? 'DESC' : 'ASC';
      } else {
        userSort.key = key;
        userSort.order = 'ASC';
      }
      renderUsersTab();
    }

    function togglePostSort(key) {
      if (postSort.key === key) {
        postSort.order = postSort.order === 'ASC' ? 'DESC' : 'ASC';
      } else {
        postSort.key = key;
        postSort.order = 'ASC';
      }
      renderPostsTab();
    }

    // =====================================================================
    // WORDPRESS TWO-COLUMN RICH RECORD EDITOR (ALL 54 TABLES)
    // =====================================================================
    function openRecordEditorDecoded(tableName, encodedRow) {
      const row = decodeRowData(encodedRow);
      openRecordEditor(tableName, row, true);
    }

    async function openRecordEditor(tableName, initialData = null, isExistingRow = false) {
      let meta = schemaByTable[tableName];
      if (!meta || !meta.columns || meta.columns.length === 0) {
        try {
          const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}?limit=1`);
          meta = {
            tableName,
            rowCount: res.totalRows,
            columnCount: (res.columns || []).length,
            primaryKeys: res.primaryKeys || ['id'],
            columns: (res.columns || []).map(c => ({
              columnName: c.Field,
              columnType: c.Type,
              isNullable: c.Null,
              columnKey: c.Key,
              columnDefault: c.Default,
              extra: c.Extra
            }))
          };
          schemaByTable[tableName] = meta;
        } catch (err) {
          showNotice(`Cannot load schema for ${tableName}: ${err.message}`, true);
          return;
        }
      }

      const mode = isExistingRow ? 'edit' : 'create';
      const rowObj = initialData ? Object.assign({}, initialData) : {};
      const whereKey = isExistingRow ? extractWhereKey(tableName, rowObj) : {};

      editorState = {
        mode,
        tableName,
        originalRow: rowObj,
        whereKey,
        columns: meta.columns || [],
        primaryKeys: meta.primaryKeys || []
      };

      document.getElementById('editorModeBadge').textContent = mode === 'edit' ? 'Edit Record' : 'Add New Record';
      document.getElementById('editorModeBadge').className =
        mode === 'edit'
          ? 'bg-slate-900 text-white text-[11px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider'
          : 'bg-emerald-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider';

      const pkSummary = editorState.primaryKeys.map(k => `${k}=${rowObj[k] ?? '(auto)'}`).join(', ');
      document.getElementById('editorModalTitle').textContent =
        mode === 'edit' ? `Editing ${tableName} (${pkSummary})` : `Create New Record in ${tableName}`;
      document.getElementById('editorTableSubtitle').textContent =
        `${editorState.columns.length} Database Columns`;
      document.getElementById('editorPkBadge').textContent =
        `PK: ${editorState.primaryKeys.join(', ') || 'auto'}`;

      document.getElementById('editorPublishSummary').innerHTML = `
        <div><strong>Target Table:</strong> <code class="font-mono-num bg-slate-100 px-1 py-0.5 rounded text-slate-800">${esc(tableName)}</code></div>
        <div><strong>Operation:</strong> ${mode === 'edit' ? 'SQL UPDATE (Existing Row)' : 'SQL INSERT (New Row)'}</div>
        <div><strong>Schema Safety:</strong> Strictly preserves all 54 tables & columns</div>
      `;

      document.getElementById('editorDeleteBtn').classList.toggle('hidden', mode !== 'edit');
      document.getElementById('editorCloneBtn').classList.toggle('hidden', mode !== 'edit');
      document.getElementById('editorSaveBtnText').textContent =
        mode === 'edit' ? 'Save Changes' : 'Insert Record';
      document.getElementById('editorFormError').classList.add('hidden');

      renderEditorFieldsets();
      renderEditorSidebarBoxes();

      document.getElementById('editorRawJsonPre').textContent = JSON.stringify(rowObj, null, 2);
      document.getElementById('wpEditorModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeRecordEditor() {
      document.getElementById('wpEditorModal').classList.add('hidden');
    }

    function renderEditorFieldsets() {
      const { tableName, columns, originalRow, mode } = editorState;
      const colMap = {};
      columns.forEach(c => { colMap[c.columnName] = c; });

      let groups = [];
      const assigned = new Set();

      if (tableName === 'users') {
        for (const g of USER_COLUMN_GROUPS) {
          const validCols = g.fields.filter(f => colMap[f]).map(f => {
            assigned.add(f);
            return colMap[f];
          });
          if (validCols.length > 0) groups.push({ title: g.title, cols: validCols });
        }
      } else if (tableName === 'posts') {
        for (const g of POST_COLUMN_GROUPS) {
          const validCols = g.fields.filter(f => colMap[f]).map(f => {
            assigned.add(f);
            return colMap[f];
          });
          if (validCols.length > 0) groups.push({ title: g.title, cols: validCols });
        }
      }

      const remainingCols = columns.filter(c => !assigned.has(c.columnName));
      if (remainingCols.length > 0) {
        groups.push({
          title: groups.length > 0 ? `Additional ${tableName} Schema Columns (${remainingCols.length})` : `All ${tableName} Columns (${remainingCols.length})`,
          cols: remainingCols
        });
      }

      const container = document.getElementById('editorMainColumn');
      container.innerHTML = groups.map(grp => `
        <div class="wp-postbox !mb-0">
          <div class="wp-postbox-header">
            <span>${esc(grp.title)}</span>
            <span class="font-mono-num text-xs text-slate-500 font-normal">${grp.cols.length} fields</span>
          </div>
          <div class="wp-postbox-inside grid grid-cols-1 sm:grid-cols-2 gap-4">
            ${grp.cols.map(col => renderSingleColumnInput(col, originalRow[col.columnName], mode)).join('')}
          </div>
        </div>
      `).join('');
    }

    function renderSingleColumnInput(col, currentVal, mode) {
      const name = col.columnName;
      const typeLower = String(col.columnType || '').toLowerCase();
      const isPk = col.columnKey === 'PRI';
      const isAutoInc = String(col.extra || '').toLowerCase().includes('auto_increment');
      const isNullable = col.isNullable === 'YES';

      const valStr = currentVal === null || currentVal === undefined ? '' : typeof currentVal === 'object' ? JSON.stringify(currentVal) : String(currentVal);

      const isLongText =
        typeLower.includes('text') ||
        name === 'bio' ||
        name === 'content' ||
        name === 'excerpt' ||
        name === 'answer' ||
        name === 'description' ||
        valStr.length > 110;

      const labelHtml = `
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-semibold text-slate-900 font-mono-num">
            ${esc(name)} ${isPk ? '<span class="text-slate-900 font-bold" title="Primary Key">🔑</span>' : ''}
          </label>
          <span class="font-mono-num text-[10px] text-slate-400">${esc(col.columnType)}${isNullable ? ' · null' : ''}</span>
        </div>
      `;

      if (typeLower.startsWith('tinyint(1)') || typeLower === 'boolean' || name.startsWith('is_') || name.startsWith('is')) {
        if (typeLower.includes('tinyint') || typeLower === 'boolean') {
          const isChecked = currentVal === 1 || currentVal === true || currentVal === '1' || currentVal === 'true';
          return `
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl">
              ${labelHtml}
              <select name="${esc(name)}" class="wp-select w-full font-mono-num">
                <option value="1" ${isChecked ? 'selected' : ''}>1 (True / Enabled)</option>
                <option value="0" ${!isChecked ? 'selected' : ''}>0 (False / Disabled)</option>
              </select>
            </div>
          `;
        }
      }

      if (typeLower.startsWith('enum(')) {
        const matches = col.columnType.match(/'([^']+)'/g) || [];
        const options = matches.map(m => m.replace(/^'|'$/g, ''));
        return `
          <div>
            ${labelHtml}
            <select name="${esc(name)}" class="wp-select w-full font-mono-num">
              ${isNullable ? `<option value="">-- NULL --</option>` : ''}
              ${options.map(opt => `<option value="${esc(opt)}" ${valStr === opt ? 'selected' : ''}>${esc(opt)}</option>`).join('')}
            </select>
          </div>
        `;
      }

      if (name === 'postType') {
        return `
          <div>
            ${labelHtml}
            <select name="postType" class="wp-select w-full font-mono-num font-semibold">
              <option value="reel" ${valStr === 'reel' ? 'selected' : ''}>reel (Vertical Video Reel)</option>
              <option value="image" ${valStr === 'image' ? 'selected' : ''}>image (Image Post)</option>
              <option value="text" ${valStr === 'text' ? 'selected' : ''}>text (Text Post)</option>
              <option value="post" ${valStr === 'post' || !valStr ? 'selected' : ''}>post (Standard Feed Post)</option>
            </select>
          </div>
        `;
      }

      if (isLongText) {
        return `
          <div class="sm:col-span-2">
            ${labelHtml}
            <textarea name="${esc(name)}" rows="3" class="wp-textarea w-full font-mono-num text-xs" placeholder="${isNullable ? 'NULL / Empty' : ''}">${esc(valStr)}</textarea>
          </div>
        `;
      }

      const isTimestampBigint = typeLower.includes('bigint') && (name.toLowerCase().includes('time') || name.toLowerCase().includes('created') || name.toLowerCase().includes('updated') || name.toLowerCase().includes('date'));
      if (isTimestampBigint) {
        return `
          <div>
            ${labelHtml}
            <div class="flex items-center gap-1.5">
              <input type="text" name="${esc(name)}" value="${esc(valStr)}" placeholder="${mode === 'create' ? 'Auto (Now)' : ''}" class="wp-input w-full font-mono-num" />
              <button type="button" onclick="this.previousElementSibling.value = Date.now()" class="wp-btn wp-btn-secondary !px-2 !text-[11px]" title="Set to current epoch ms">Now</button>
            </div>
          </div>
        `;
      }

      const placeholder = isAutoInc && mode === 'create'
        ? 'Auto-Increment'
        : isPk && mode === 'create'
          ? 'Leave blank to auto-generate UUID'
          : isNullable
            ? 'NULL'
            : '';

      return `
        <div>
          ${labelHtml}
          <input
            type="text"
            name="${esc(name)}"
            value="${esc(valStr)}"
            placeholder="${esc(placeholder)}"
            ${isAutoInc && mode === 'edit' ? 'readonly class="wp-input w-full font-mono-num bg-slate-100 text-slate-500"' : 'class="wp-input w-full font-mono-num"'}
          />
        </div>
      `;
    }

    function renderEditorSidebarBoxes() {
      const { tableName, originalRow, mode } = editorState;
      const modBox = document.getElementById('editorQuickModerationBox');
      const modContent = document.getElementById('editorQuickModerationContent');
      const mediaBox = document.getElementById('editorMediaPreviewBox');
      const mediaContent = document.getElementById('editorMediaPreviewContent');

      if (mode === 'edit' && tableName === 'users' && originalRow.uid) {
        modBox.classList.remove('hidden');
        modContent.innerHTML = `
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-700">Verified Badge (<code class="font-mono-num bg-slate-100 px-1 rounded">is_verified</code>)</span>
            <button type="button" onclick="setFormFieldValue('is_verified', '${originalRow.is_verified ? '0' : '1'}')" class="wp-btn wp-btn-secondary !min-h-[26px] !px-2.5 !text-xs">
              Toggle Verified
            </button>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-700">Admin Privileges (<code class="font-mono-num bg-slate-100 px-1 rounded">isAdmin</code>)</span>
            <button type="button" onclick="setFormFieldValue('isAdmin', '${originalRow.isAdmin ? '0' : '1'}'); setFormFieldValue('role', '${originalRow.isAdmin ? 'user' : 'admin'}')" class="wp-btn wp-btn-secondary !min-h-[26px] !px-2.5 !text-xs">
              Toggle Admin
            </button>
          </div>
        `;
      } else if (mode === 'edit' && tableName === 'posts' && originalRow.id) {
        modBox.classList.remove('hidden');
        modContent.innerHTML = `
          <div class="space-y-2 text-xs">
            <span class="text-slate-700 font-medium block">Set Post Type:</span>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" onclick="setFormFieldValue('postType', 'reel')" class="wp-btn wp-btn-secondary !min-h-[26px] !px-2 !text-xs">Reel</button>
              <button type="button" onclick="setFormFieldValue('postType', 'image')" class="wp-btn wp-btn-secondary !min-h-[26px] !px-2 !text-xs">Image</button>
              <button type="button" onclick="setFormFieldValue('postType', 'text')" class="wp-btn wp-btn-secondary !min-h-[26px] !px-2 !text-xs">Text</button>
            </div>
          </div>
          <div class="pt-2 border-t border-slate-100">
            <a href="/post/${encodeURIComponent(originalRow.id)}" target="_blank" class="text-xs text-emerald-700 hover:underline flex items-center gap-1 font-semibold">
              Open Live Page (/post/${esc(String(originalRow.id).slice(0, 8))}…) &rarr;
            </a>
          </div>
        `;
      } else {
        modBox.classList.add('hidden');
      }

      const videoUrl = originalRow?.videoUrl;
      const imgUrl = originalRow?.imageUrl || originalRow?.photoUrl || originalRow?.thumbnailUrl || originalRow?.image;
      if (videoUrl || imgUrl) {
        mediaBox.classList.remove('hidden');
        mediaContent.innerHTML = `
          ${videoUrl ? `
            <div class="mb-2">
              <div class="text-[11px] font-semibold text-slate-500 mb-1">Video Reel Stream:</div>
              <video src="${esc(videoUrl)}" controls playsinline class="w-full max-h-64 bg-slate-900 rounded-xl border border-slate-200"></video>
            </div>
          ` : ''}
          ${imgUrl ? `
            <div>
              <div class="text-[11px] font-semibold text-slate-500 mb-1">Image / Avatar Asset:</div>
              <img src="${esc(imgUrl)}" alt="Preview" class="w-full max-h-56 object-contain bg-slate-50 rounded-xl border border-slate-200" onerror="this.style.display='none'" />
            </div>
          ` : ''}
        `;
      } else {
        mediaBox.classList.add('hidden');
      }
    }

    function setFormFieldValue(fieldName, val) {
      const form = document.getElementById('wpRecordEditorForm');
      const el = form.elements[fieldName];
      if (el) {
        el.value = val;
        el.classList.add('!border-emerald-500', '!bg-emerald-50');
      }
    }

    async function saveRecordEditor(e) {
      e.preventDefault();
      const errBox = document.getElementById('editorFormError');
      const saveBtn = document.getElementById('editorSaveBtn');
      errBox.classList.add('hidden');

      const form = document.getElementById('wpRecordEditorForm');
      const formData = new FormData(form);
      const dataPayload = {};
      for (const [k, v] of formData.entries()) {
        dataPayload[k] = v;
      }

      saveBtn.disabled = true;
      try {
        const { mode, tableName, whereKey } = editorState;
        if (mode === 'create') {
          const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/row`, {
            method: 'POST',
            body: JSON.stringify({ data: dataPayload })
          });
          showNotice(res.message || `Created new row in ${tableName}.`);
        } else {
          const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/row`, {
            method: 'PUT',
            body: JSON.stringify({ whereKey, data: dataPayload })
          });
          showNotice(res.message || `Updated record in ${tableName}.`);
        }
        closeRecordEditor();
        await loadDashboardData(true);
        if (activeTab === 'explorer') {
          await loadExplorerTable(explorerState.tableName, explorerState.offset);
        }
      } catch (err) {
        errBox.textContent = err.message || 'Failed to save record.';
        errBox.classList.remove('hidden');
      } finally {
        saveBtn.disabled = false;
      }
    }

    async function cloneCurrentEditorRecord() {
      const form = document.getElementById('wpRecordEditorForm');
      const formData = new FormData(form);
      const cloneData = {};
      for (const [k, v] of formData.entries()) {
        cloneData[k] = v;
      }
      for (const pk of editorState.primaryKeys) {
        cloneData[pk] = '';
      }
      openRecordEditor(editorState.tableName, cloneData, false);
    }

    async function deleteCurrentEditorRecord() {
      const { tableName, whereKey } = editorState;
      try {
        const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/row`, {
          method: 'DELETE',
          body: JSON.stringify({ whereKey })
        });
        closeRecordEditor();
        showNotice(res.message || `Deleted record from ${tableName}.`);
        await loadDashboardData(true);
      } catch (err) {
        const errBox = document.getElementById('editorFormError');
        errBox.textContent = err.message;
        errBox.classList.remove('hidden');
      }
    }

    async function confirmDeleteRow(tableName, encodedRow) {
      const row = decodeRowData(encodedRow);
      const whereKey = extractWhereKey(tableName, row);
      try {
        const res = await apiRequest(`/api/admin/table/${encodeURIComponent(tableName)}/row`, {
          method: 'DELETE',
          body: JSON.stringify({ whereKey })
        });
        showNotice(res.message || `Deleted row from ${tableName}.`);
        await loadDashboardData(true);
        if (activeTab === 'explorer') {
          await loadExplorerTable(explorerState.tableName, explorerState.offset);
        }
      } catch (err) {
        showNotice(`Delete error: ${err.message}`, true);
      }
    }

    // =====================================================================
    // ONE-CLICK ANDROID MODERATION & QUICK ACTIONS
    // =====================================================================
    async function quickAction(actionType, payload) {
      try {
        const res = await apiRequest('/api/admin/quick-action', {
          method: 'POST',
          body: JSON.stringify(Object.assign({ actionType }, payload))
        });
        showNotice(res.message || 'Moderation update applied.');
        await loadDashboardData(true);
      } catch (err) {
        showNotice(`Quick action failed: ${err.message}`, true);
      }
    }

    function toggleSelectAll(checkboxClass, checked) {
      document.querySelectorAll(`.${checkboxClass}`).forEach(cb => {
        cb.checked = checked;
      });
    }

    function exportRowsToCsv(filename, rows) {
      if (!rows || rows.length === 0) return;
      const headers = Object.keys(rows[0]);
      const csvLines = [
        headers.join(','),
        ...rows.map(r =>
          headers.map(h => {
            const val = r[h] === null || r[h] === undefined ? '' : String(r[h]).replace(/"/g, '""');
            return `"${val}"`;
          }).join(',')
        )
      ];
      const blob = new Blob([csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function copyEditorJson() {
      const text = document.getElementById('editorRawJsonPre').textContent;
      navigator.clipboard.writeText(text);
      showNotice('Copied raw record JSON to clipboard.');
    }

    // =====================================================================
    // EVENT LISTENERS & INITIALIZATION
    // =====================================================================
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();

      const pinInput = document.getElementById('pinInput');
      document.querySelectorAll('.pin-digit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (pinInput.value.length < 4) {
            pinInput.value += btn.dataset.digit;
            if (pinInput.value.length === 4) {
              verifyPinAndLoad(pinInput.value);
            }
          }
        });
      });

      document.getElementById('pinClearBtn').addEventListener('click', () => {
        pinInput.value = '';
        pinInput.focus();
      });

      document.getElementById('pinForm').addEventListener('submit', () => {
        verifyPinAndLoad(pinInput.value.trim());
      });

      // Mobile Sidebar Drawer Toggle
      document.getElementById('mobileSidebarBtn').addEventListener('click', () => {
        document.getElementById('adminmenuwrap').classList.toggle('-translate-x-full');
      });

      // Sidebar 54-Table Filter
      document.getElementById('sidebarTableFilter').addEventListener('input', (e) => {
        renderSidebarTableList(e.target.value);
      });

      // Top Quick Jump Select
      document.getElementById('quickJumpTableSelect').addEventListener('change', (e) => {
        if (e.target.value) {
          openTableInExplorer(e.target.value);
        }
      });

      // Global Search Input
      document.getElementById('globalSearchInput').addEventListener('input', (e) => {
        globalSearchTerm = e.target.value || '';
        renderActiveTab();
      });

      // Refresh DB Button
      document.getElementById('refreshDashboardBtn').addEventListener('click', () => {
        loadDashboardData();
      });

      // Lock Console Button
      document.getElementById('lockAdminBtn').addEventListener('click', () => {
        sessionStorage.removeItem(ADMIN_STORAGE_KEY);
        currentPin = '';
        pinInput.value = '';
        document.getElementById('adminConsoleShell').classList.add('hidden');
        document.getElementById('pinGateOverlay').classList.remove('hidden');
      });

      // User Status Filter Links
      document.querySelectorAll('.user-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeUserFilter = btn.dataset.ufilter;
          document.querySelectorAll('.user-filter-btn').forEach(b => {
            b.className = b === btn
              ? 'user-filter-btn font-bold text-slate-900 bg-slate-200/60 px-2.5 py-1 rounded-md'
              : 'user-filter-btn text-slate-600 hover:text-slate-900 font-medium px-2 py-1';
          });
          renderUsersTab();
        });
      });

      // Post Status Filter Links
      document.querySelectorAll('.post-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activePostFilter = btn.dataset.pfilter;
          document.querySelectorAll('.post-filter-btn').forEach(b => {
            b.className = b === btn
              ? 'post-filter-btn font-bold text-slate-900 bg-slate-200/60 px-2.5 py-1 rounded-md'
              : 'post-filter-btn text-slate-600 hover:text-slate-900 font-medium px-2 py-1';
          });
          renderPostsTab();
        });
      });

      // Explorer Controls
      document.getElementById('explorerTableSelect').addEventListener('change', (e) => {
        loadExplorerTable(e.target.value, 0);
      });
      document.getElementById('explorerSearchBtn').addEventListener('click', () => {
        explorerState.search = document.getElementById('explorerSearchInput').value.trim();
        loadExplorerTable(explorerState.tableName, 0);
      });
      document.getElementById('explorerSearchInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          explorerState.search = e.target.value.trim();
          loadExplorerTable(explorerState.tableName, 0);
        }
      });
      document.getElementById('explorerPrevBtn').addEventListener('click', () => {
        loadExplorerTable(explorerState.tableName, Math.max(0, explorerState.offset - explorerState.limit));
      });
      document.getElementById('explorerNextBtn').addEventListener('click', () => {
        loadExplorerTable(explorerState.tableName, explorerState.offset + explorerState.limit);
      });
      document.getElementById('explorerAddNewRowBtn').addEventListener('click', () => {
        openRecordEditor(explorerState.tableName, null, false);
      });
      document.getElementById('explorerExportCsvBtn').addEventListener('click', () => {
        exportRowsToCsv(`${explorerState.tableName}_export.csv`, explorerState.rows);
      });

      // Auto-Unlock if PIN 9292 already in sessionStorage
      if (currentPin) {
        verifyPinAndLoad(currentPin);
      }
    });
  </script>
</body>
</html>
