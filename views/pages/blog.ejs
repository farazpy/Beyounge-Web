<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section" style="padding-top: 9rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-emerald"><i data-lucide="book-open"></i> Fitness Science Journal</span>
      <h1 class="section-title">Latest Articles & Research</h1>
      <p style="font-size: 1.25rem;">
        Evidence-based workout routines, AI hypertrophy research, and practical nutrition guides.
      </p>

      <!-- Category Filter Buttons -->
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem;">
        <button class="btn btn-primary btn-sm blog-filter-btn" data-category="all">All Articles</button>
        <button class="btn btn-secondary btn-sm blog-filter-btn" data-category="AI Technology">AI Technology</button>
        <button class="btn btn-secondary btn-sm blog-filter-btn" data-category="Nutrition">Nutrition</button>
        <button class="btn btn-secondary btn-sm blog-filter-btn" data-category="Wellness">Wellness</button>
      </div>
    </div>

    <div class="blog-grid">
      <% posts.forEach(post => { %>
        <div class="glass-card blog-card reveal-on-scroll" data-category="<%= post.category %>">
          <div class="blog-card-meta">
            <span class="badge badge-emerald" style="font-size: 0.7rem;"><%= post.category %></span>
            <span><%= post.readTime %></span>
            <span>• <%= post.publishedDate %></span>
          </div>
          <h3 class="blog-card-title"><%= post.title %></h3>
          <p class="blog-card-excerpt"><%= post.excerpt %></p>
          <a href="/blog/<%= post.slug %>" class="btn btn-secondary btn-sm" style="margin-top: auto;">
            <span>Read Article</span>
            <i data-lucide="arrow-right"></i>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
