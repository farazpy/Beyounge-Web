<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section" style="padding-top: 9rem;">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-emerald"><i data-lucide="briefcase"></i> Join Our Team</span>
      <h1 class="section-title">Help Build the Future of AI Fitness</h1>
      <p style="font-size: 1.25rem;">
        We're a remote-first team of passion-driven engineers, sports scientists, and product designers.
      </p>
    </div>

    <!-- Job Listings -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem; max-width: 900px; margin: 0 auto 4rem auto;">
      <% jobs.forEach(job => { %>
        <div class="glass-card reveal-on-scroll" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
          <div>
            <div style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.5rem;">
              <span class="badge badge-purple"><%= job.department %></span>
              <span style="font-size: 0.85rem; color: var(--text-muted);"><%= job.type %> • <%= job.location %></span>
            </div>
            <h3 style="font-size: 1.35rem; margin-bottom: 0.5rem;"><%= job.title %></h3>
            <p style="font-size: 0.95rem; color: var(--text-secondary);"><%= job.description %></p>
          </div>
          <div>
            <a href="/contact" class="btn btn-primary btn-sm">
              <span>Apply Now</span>
              <i data-lucide="arrow-right"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
